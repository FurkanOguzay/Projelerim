        <h5 class="mb-0">
            <i class="bi bi-heart me-2"></i>Favorilerim
        </h5>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Favorilere eklediğiniz ürünler burada listelenir. 
            <a href="/Favorites" class="alert-link">Tüm favorileri görüntüle</a>
        </div>
        
        <div class="text-center py-4">
            <a href="/Favorites" class="btn btn-outline-primary btn-lg">
