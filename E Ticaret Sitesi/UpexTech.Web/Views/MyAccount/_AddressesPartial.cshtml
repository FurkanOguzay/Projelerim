@model MyAccountViewModel

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-geo-alt me-2"></i>Adres Bilgilerim
        </h5>
    </div>
    <div class="card-body">
        @if (Model.User != null)
        {
            <form asp-action="UpdateAddress" method="post">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Kayıtlı adresiniz siparişlerinizde varsayılan teslimat adresi olarak kullanılacaktır.
                        </div>
                    </div>
                    
                    <div class="col-12">
                        <label class="form-label">Teslimat Adresi</label>
                        <textarea class="form-control" name="address" rows="4" 
                                  placeholder="Mahalle, sokak, bina no, daire no, ilçe, il...">@Model.User.Address</textarea>
                    </div>
                    
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Adresi Kaydet
                        </button>
                    </div>
                </div>
            </form>

            <hr class="my-4">

            <!-- Adres Kartları - Gelecekte birden fazla adres desteği için -->
            <h6 class="text-muted mb-3">Kayıtlı Adresler</h6>
            
            @if (!string.IsNullOrEmpty(Model.User.Address))
            {
                <div class="row">
                    <div class="col-md-6">
                        <div class="border rounded p-3 position-relative">
                            <span class="badge bg-primary position-absolute top-0 end-0 m-2">Varsayılan</span>
                            <h6><i class="bi bi-house me-2"></i>Ev Adresi</h6>
                            <p class="text-muted mb-2">@Model.User.Address</p>
                            <small class="text-muted">
                                <i class="bi bi-person me-1"></i>@Model.User.FullName
                                @if (!string.IsNullOrEmpty(Model.User.Phone))
                                {
                                    <span class="ms-3"><i class="bi bi-telephone me-1"></i>@Model.User.Phone</span>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-geo-alt display-4"></i>
                    <p class="mt-2">Henüz kayıtlı adres bulunmuyor.</p>
                </div>
            }
        }
        else
        {
            <div class="alert alert-warning">
                Kullanıcı bilgileri yüklenemedi.
            </div>
        }
    </div>
</div>
