@model MyAccountViewModel

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-person-badge me-2"></i>Kullanıcı Bilgilerim
        </h5>
    </div>
    <div class="card-body">
        @if (Model.User != null)
        {
            <form asp-action="UpdateProfile" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Ad <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="FirstName" value="@Model.User.FirstName" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Soyad <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="LastName" value="@Model.User.LastName" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">E-posta</label>
                        <input type="email" class="form-control" value="@Model.User.Email" disabled>
                        <small class="text-muted">E-posta adresi değiştirilemez.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Telefon</label>
                        <input type="tel" class="form-control" name="Phone" value="@Model.User.Phone" placeholder="05XX XXX XX XX">
                    </div>
                    
                    @if (Model.User.Role == UserRole.B2B)
                    {
                        <div class="col-12">
                            <hr>
                            <h6 class="text-muted mb-3"><i class="bi bi-building me-2"></i>Firma Bilgileri</h6>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Firma Adı</label>
                            <input type="text" class="form-control" value="@Model.User.CompanyName" disabled>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Vergi No</label>
                            <input type="text" class="form-control" value="@Model.User.TaxNumber" disabled>
                        </div>
                    }
                    
                    <div class="col-12">
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>Kayıt Tarihi: @Model.User.CreatedAt.ToString("dd.MM.yyyy")
                                </small>
                                <br>
                                <small class="text-muted">
                                    <i class="bi bi-person-badge me-1"></i>Hesap Tipi: 
                                    @(Model.User.Role == UserRole.B2B ? "Bayi Hesabı" : "Bireysel Hesap")
                                </small>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>Bilgileri Güncelle
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-warning">
                Kullanıcı bilgileri yüklenemedi.
            </div>
        }
    </div>
</div>
