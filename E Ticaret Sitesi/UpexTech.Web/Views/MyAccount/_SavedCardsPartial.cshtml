@model MyAccountViewModel

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-semibold mb-1">
                <i data-lucide="credit-card" class="me-2 text-primary" style="width: 24px; height: 24px;"></i>
                Kayıtlı Kartlarım
            </h4>
            <p class="text-muted mb-0">Kayıtlı ödeme kartlarınızı yönetin.</p>
        </div>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addCardModal">
            <i data-lucide="plus" style="width: 16px; height: 16px;" class="me-1"></i>
            Yeni Kart Ekle
        </button>
    </div>
</div>

@if (Model.SavedCards?.Any() == true)
{
    <div class="row g-3" id="cardsContainer">
        @foreach (var card in Model.SavedCards)
        {
            <div class="col-md-6" id="card-@card.Id">
                <div class="card border @(card.IsDefault ? "border-primary" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge @(card.CardType == "Visa" ? "bg-primary" : card.CardType == "MasterCard" ? "bg-danger" : "bg-info") me-2">
                                    @card.CardType
                                </span>
                                @if (card.IsDefault)
                                {
                                    <span class="badge bg-success">Varsayılan</span>
                                }
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
                                    <i data-lucide="more-vertical" style="width: 18px; height: 18px;"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (!card.IsDefault)
                                    {
                                        <li><a class="dropdown-item" href="#" onclick="setDefaultCard(@card.Id); return false;">Varsayılan Yap</a></li>
                                    }
                                    <li><a class="dropdown-item text-danger" href="#" onclick="deleteCard(@card.Id); return false;">Kartı Sil</a></li>
                                </ul>
                            </div>
                        </div>
                        <h5 class="font-monospace mb-2">@card.CardNumber</h5>
                        <div class="d-flex justify-content-between text-muted small">
                            <span>@card.CardHolderName</span>
                            <span>@card.ExpiryDate</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5" id="emptyState">
        <i data-lucide="credit-card" class="text-muted mb-3" style="width: 48px; height: 48px;"></i>
        <h5 class="text-muted">Kayıtlı kartınız bulunmuyor</h5>
        <p class="text-muted small">Ödeme işlemlerini hızlandırmak için kart ekleyebilirsiniz.</p>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCardModal">
            Kart Ekle
        </button>
    </div>
}

<!-- Modal -->
<div class="modal fade" id="addCardModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Kart Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Kart Numarası <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="cardNumber" 
                           placeholder="1234 5678 9012 3456" maxlength="19"
                           oninput="formatCardNumber(this)">
                    <div class="form-text text-danger d-none" id="cardNumberError">Geçersiz kart numarası</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Kart Üzerindeki İsim <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="cardHolderName" 
                           placeholder="AD SOYAD" style="text-transform: uppercase;">
                    <div class="form-text text-danger d-none" id="cardHolderError">İsim en az 3 karakter olmalıdır</div>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label">Son Kullanma <span class="text-danger">*</span></label>
                        <div class="d-flex gap-2">
                            <select class="form-select" id="expiryMonth">
                                <option value="">Ay</option>
                                <option value="01">01</option>
                                <option value="02">02</option>
                                <option value="03">03</option>
                                <option value="04">04</option>
                                <option value="05">05</option>
                                <option value="06">06</option>
                                <option value="07">07</option>
                                <option value="08">08</option>
                                <option value="09">09</option>
                                <option value="10">10</option>
                                <option value="11">11</option>
                                <option value="12">12</option>
                            </select>
                            <select class="form-select" id="expiryYear">
                                <option value="">Yıl</option>
                                @for (int year = DateTime.Now.Year; year <= DateTime.Now.Year + 10; year++)
                                {
                                    <option value="@(year.ToString().Substring(2))">@year</option>
                                }
                            </select>
                        </div>
                        <div class="form-text text-danger d-none" id="expiryError">Son kullanma tarihi seçiniz</div>
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label">CVV <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="cvv" 
                               placeholder="***" maxlength="4">
                        <div class="form-text text-danger d-none" id="cvvError">CVV geçersiz</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" onclick="saveCard()" id="saveCardBtn">
                    <span class="spinner-border spinner-border-sm d-none" id="saveSpinner"></span>
                    Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function formatCardNumber(input) {
    let value = input.value.replace(/\D/g, '');
    let formatted = '';
    for (let i = 0; i < value.length && i < 16; i++) {
        if (i > 0 && i % 4 === 0) formatted += ' ';
        formatted += value[i];
    }
    input.value = formatted;
}

function validateCardNumber(cardNumber) {
    const cleaned = cardNumber.replace(/\s/g, '');
    return /^\d{16}$/.test(cleaned);
}

async function saveCard() {
    // Reset errors
    document.querySelectorAll('.form-text.text-danger').forEach(el => el.classList.add('d-none'));
    
    const cardNumber = document.getElementById('cardNumber').value;
    const cardHolderName = document.getElementById('cardHolderName').value;
    const expiryMonth = document.getElementById('expiryMonth').value;
    const expiryYear = document.getElementById('expiryYear').value;
    const cvv = document.getElementById('cvv').value;
    
    let hasError = false;
    
    // Validate card number
    if (!validateCardNumber(cardNumber)) {
        document.getElementById('cardNumberError').classList.remove('d-none');
        hasError = true;
    }
    
    // Validate card holder name
    if (!cardHolderName || cardHolderName.trim().length < 3) {
        document.getElementById('cardHolderError').classList.remove('d-none');
        hasError = true;
    }
    
    // Validate expiry
    if (!expiryMonth || !expiryYear) {
        document.getElementById('expiryError').classList.remove('d-none');
        hasError = true;
    }
    
    // Validate CVV
    if (!cvv || cvv.length < 3) {
        document.getElementById('cvvError').classList.remove('d-none');
        hasError = true;
    }
    
    if (hasError) return;
    
    // Show spinner
    document.getElementById('saveSpinner').classList.remove('d-none');
    document.getElementById('saveCardBtn').disabled = true;
    
    try {
        const response = await fetch('/MyAccount/AddCard', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                cardNumber: cardNumber,
                cardHolderName: cardHolderName,
                expiryMonth: expiryMonth,
                expiryYear: expiryYear
            })
        });
        const data = await response.json();
        
        if (data.success) {
            alert('Kart başarıyla eklendi!');
            location.reload();
        } else {
            alert(data.message || 'Bir hata oluştu');
        }
    } catch (error) {
        alert('Bir hata oluştu');
    } finally {
        document.getElementById('saveSpinner').classList.add('d-none');
        document.getElementById('saveCardBtn').disabled = false;
    }
}

async function deleteCard(cardId) {
    if (!confirm('Bu kartı silmek istediğinizden emin misiniz?')) {
        return;
    }
    
    try {
        const response = await fetch('/MyAccount/DeleteCard', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cardId: cardId })
        });
        const data = await response.json();
        
        if (data.success) {
            alert('Kart silindi!');
            location.reload();
        } else {
            alert(data.message || 'Bir hata oluştu');
        }
    } catch (error) {
        alert('Bir hata oluştu');
    }
}

async function setDefaultCard(cardId) {
    try {
        const response = await fetch('/MyAccount/SetDefaultCard', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cardId: cardId })
        });
        const data = await response.json();
        
        if (data.success) {
            alert('Varsayılan kart güncellendi!');
            location.reload();
        } else {
            alert(data.message || 'Bir hata oluştu');
        }
    } catch (error) {
        alert('Bir hata oluştu');
    }
}

// Initialize lucide icons
document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
});
</script>
