@model RegisterViewModel
@{
    ViewData["Title"] = "Üye Ol";
    Layout = null;
    var isDealer = Context.Request.Query["dealer"] == "true" || Model.IsDealer;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UpexTech</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-page">
    <div class="d-flex align-items-center justify-content-center" style="min-height: 100vh; padding: 1rem;">
        <div class="login-card" style="max-width: 500px;">
            
            @* Geri Butonu *@
            <div class="mb-4">
                <a href="/" class="login-back-link">
                    <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
                    <span>Ana Sayfaya Dön</span>
                </a>
            </div>

            @* Logo *@
            <div class="text-center mb-4">
                <a href="/">
                    <img src="~/images/upex-logo.png" alt="UpexTech" class="login-logo">
                </a>
                
                @if (isDealer)
                {
                    <div class="login-type-icon dealer mx-auto mb-3" style="width: 60px; height: 60px;">
                        <i data-lucide="building-2" style="width: 28px; height: 28px;"></i>
                    </div>
                    <h1 class="fs-4 fw-bold text-dark">Bayi Başvurusu</h1>
                    <p class="text-muted small">Toptan fiyatlardan yararlanmak için başvurun</p>
                }
                else
                {
                    <div class="login-type-icon customer mx-auto mb-3" style="width: 60px; height: 60px;">
                        <i data-lucide="user-plus" style="width: 28px; height: 28px;"></i>
                    </div>
                    <h1 class="fs-4 fw-bold text-dark">Üye Ol</h1>
                    <p class="text-muted small">Ücretsiz üye olun, özel fiyatları görün</p>
                }
            </div>

            @* Form *@
            <form asp-action="Register" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label small fw-medium"></label>
                        <div class="form-input-icon">
                            <i data-lucide="user" style="width: 20px; height: 20px;"></i>
                            <input asp-for="FirstName" class="form-control" placeholder="Ad" />
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label small fw-medium"></label>
                        <div class="form-input-icon">
                            <i data-lucide="user" style="width: 20px; height: 20px;"></i>
                            <input asp-for="LastName" class="form-control" placeholder="Soyad" />
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-medium"></label>
                    <div class="form-input-icon">
                        <i data-lucide="mail" style="width: 20px; height: 20px;"></i>
                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label small fw-medium"></label>
                    <div class="form-input-icon">
                        <i data-lucide="phone" style="width: 20px; height: 20px;"></i>
                        <input asp-for="Phone" class="form-control" placeholder="05XX XXX XX XX" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label small fw-medium"></label>
                        <div class="form-input-icon">
                            <i data-lucide="lock" style="width: 20px; height: 20px;"></i>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" id="passwordInput" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        
                        <!-- Şifre Kriterleri Göstergesi -->
                        <div id="passwordRequirements" class="password-requirements mt-2" style="display: none;">
                            <p class="small text-muted mb-2 fw-medium">Şifre kriterleri:</p>
                            <div class="d-flex flex-column gap-1">
                                <div class="requirement-item" id="req-length">
                                    <i data-lucide="circle" class="req-icon" style="width: 14px; height: 14px;"></i>
                                    <span class="small">En az 8 karakter</span>
                                </div>
                                <div class="requirement-item" id="req-uppercase">
                                    <i data-lucide="circle" class="req-icon" style="width: 14px; height: 14px;"></i>
                                    <span class="small">En az 1 büyük harf (A-Z)</span>
                                </div>
                                <div class="requirement-item" id="req-lowercase">
                                    <i data-lucide="circle" class="req-icon" style="width: 14px; height: 14px;"></i>
                                    <span class="small">En az 1 küçük harf (a-z)</span>
                                </div>
                                <div class="requirement-item" id="req-number">
                                    <i data-lucide="circle" class="req-icon" style="width: 14px; height: 14px;"></i>
                                    <span class="small">En az 1 rakam (0-9)</span>
                                </div>
                                <div class="requirement-item" id="req-special">
                                    <i data-lucide="circle" class="req-icon" style="width: 14px; height: 14px;"></i>
                                    <span class="small">En az 1 özel karakter (!, @@, #, $, %)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label small fw-medium"></label>
                        <div class="form-input-icon">
                            <i data-lucide="lock" style="width: 20px; height: 20px;"></i>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                @* Bayi Checkbox *@
                <div class="form-check mb-3">
                    @if (isDealer)
                    {
                        <input asp-for="IsDealer" class="form-check-input" id="isDealerCheck" checked onchange="toggleDealerFields()" />
                    }
                    else
                    {
                        <input asp-for="IsDealer" class="form-check-input" id="isDealerCheck" onchange="toggleDealerFields()" />
                    }
                    <label asp-for="IsDealer" class="form-check-label">
                        <i data-lucide="building-2" style="width: 16px; height: 16px;" class="me-1"></i>Bayi olarak kayıt olmak istiyorum
                    </label>
                </div>

                @* Bayi Alanları *@
                <div id="dealerFields" style="@(isDealer ? "" : "display:none;")">
                    <div class="alert-success mb-3 d-flex align-items-start gap-2" style="background-color: var(--primary-50); border-color: var(--primary-100); color: var(--primary-color);">
                        <i data-lucide="info" style="width: 20px; height: 20px; flex-shrink: 0;"></i>
                        <span class="small">Bayi başvurunuz admin onayından sonra aktif olacaktır.</span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="CompanyName" class="form-label small fw-medium"></label>
                        <div class="form-input-icon">
                            <i data-lucide="building" style="width: 20px; height: 20px;"></i>
                            <input asp-for="CompanyName" class="form-control" placeholder="Firma Adı" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TaxNumber" class="form-label small fw-medium"></label>
                        <div class="form-input-icon">
                            <i data-lucide="file-text" style="width: 20px; height: 20px;"></i>
                            <input asp-for="TaxNumber" class="form-control" placeholder="Vergi Numarası" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label small fw-medium"></label>
                        <textarea asp-for="Address" class="form-control" rows="2" placeholder="Firma Adresi" style="padding-left: 0.75rem;"></textarea>
                    </div>
                    
                    <!-- Kurum Evrakları Upload Section -->
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Kurum Evrakları</label>
                        <div class="document-upload-area" id="documentUploadArea">
                            <input type="file" 
                                   name="CompanyDocuments" 
                                   id="companyDocumentsInput" 
                                   class="document-file-input"
                                   accept=".pdf,.jpg,.jpeg,.png"
                                   multiple />
                            <div class="document-upload-content">
                                <div class="document-upload-icon">
                                    <i data-lucide="upload" style="width: 32px; height: 32px;"></i>
                                </div>
                                <p class="document-upload-text">Dosya Yükle</p>
                                <p class="document-upload-hint">PDF, JPG veya PNG (Max 5MB)</p>
                            </div>
                        </div>
                        <!-- Yüklenen Dosya Listesi -->
                        <div class="uploaded-files-list" id="uploadedFilesList"></div>
                        <span class="text-danger small" id="documentError"></span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert-error mb-4">
                        <i data-lucide="alert-circle" style="width: 20px; height: 20px;"></i>
                        <p>@Model.ErrorMessage</p>
                    </div>
                }

                <button type="submit" class="btn w-100 py-2 mb-3 text-white fw-medium" 
                        style="background-color: @(isDealer ? "var(--green-600)" : "var(--primary-color)");">
                    <i data-lucide="user-plus" style="width: 18px; height: 18px;" class="me-2"></i>@(isDealer ? "Başvuru Yap" : "Üye Ol")
                </button>

                <div class="text-center">
                    <span class="text-muted small">Zaten üye misiniz?</span>
                    <a href="/Account/Login" class="small text-decoration-none fw-medium ms-1" style="color: var(--primary-color);">
                        Giriş Yap
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Initialize Lucide Icons -->
    <script>
        lucide.createIcons();
        
        function toggleDealerFields() {
            var checkbox = document.getElementById('isDealerCheck');
            var fields = document.getElementById('dealerFields');
            if (checkbox.checked) {
                fields.style.display = 'block';
            } else {
                fields.style.display = 'none';
            }
        }
        
        // Şifre validasyonu
        const passwordInput = document.getElementById('passwordInput');
        const requirements = document.getElementById('passwordRequirements');
        
        const rules = {
            'req-length': (pwd) => pwd.length >= 8,
            'req-uppercase': (pwd) => /[A-Z]/.test(pwd),
            'req-lowercase': (pwd) => /[a-z]/.test(pwd),
            'req-number': (pwd) => /[0-9]/.test(pwd),
            'req-special': (pwd) => /[!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(pwd)
        };
        
        passwordInput.addEventListener('focus', function() {
            requirements.style.display = 'block';
            lucide.createIcons();
        });
        
        passwordInput.addEventListener('blur', function() {
            // Tüm kurallar sağlandıysa gizle
            const password = this.value;
            const allValid = Object.values(rules).every(rule => rule(password));
            if (allValid || password.length === 0) {
                setTimeout(() => {
                    requirements.style.display = 'none';
                }, 200);
            }
        });
        
        passwordInput.addEventListener('input', function() {
            const password = this.value;
            
            for (const [id, rule] of Object.entries(rules)) {
                const element = document.getElementById(id);
                const icon = element.querySelector('svg');
                
                if (rule(password)) {
                    element.classList.add('valid');
                    element.classList.remove('invalid');
                    if (icon) {
                        icon.style.color = '#22c55e';
                        icon.style.fill = '#22c55e';
                    }
                } else {
                    element.classList.remove('valid');
                    element.classList.add('invalid');
                    if (icon) {
                        icon.style.color = '#94a3b8';
                        icon.style.fill = 'none';
                    }
                }
            }
            
            lucide.createIcons();
        });
    </script>
    
    <style>
        .password-requirements {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 12px;
        }
        
        .requirement-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 0;
            transition: all 0.2s ease;
        }
        
        .requirement-item.valid span {
            color: #22c55e;
        }
        
        .requirement-item.invalid span {
            color: #64748b;
        }
        
        .requirement-item svg {
            transition: all 0.2s ease;
        }
        
        /* Document Upload Styles */
        .document-upload-area {
            position: relative;
            border: 2px dashed #3b82f6;
            border-radius: 12px;
            padding: 32px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            background-color: #fafbff;
        }
        
        .document-upload-area:hover {
            background-color: #eff6ff;
            border-color: #2563eb;
        }
        
        .document-upload-area.drag-over {
            background-color: #dbeafe;
            border-color: #2563eb;
            border-style: solid;
        }
        
        .document-file-input {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }
        
        .document-upload-content {
            pointer-events: none;
        }
        
        .document-upload-icon {
            color: #9ca3af;
            margin-bottom: 8px;
        }
        
        .document-upload-area:hover .document-upload-icon {
            color: #3b82f6;
        }
        
        .document-upload-text {
            font-size: 16px;
            font-weight: 500;
            color: #374151;
            margin: 0 0 4px 0;
        }
        
        .document-upload-hint {
            font-size: 13px;
            color: #3b82f6;
            margin: 0;
        }
        
        .uploaded-files-list {
            margin-top: 12px;
        }
        
        .uploaded-file-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            margin-bottom: 8px;
        }
        
        .uploaded-file-info {
            display: flex;
            align-items: center;
            gap: 10px;
            flex: 1;
            min-width: 0;
        }
        
        .uploaded-file-icon {
            width: 36px;
            height: 36px;
            background-color: #eff6ff;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #3b82f6;
            flex-shrink: 0;
        }
        
        .uploaded-file-icon.pdf {
            background-color: #fef2f2;
            color: #ef4444;
        }
        
        .uploaded-file-icon.image {
            background-color: #f0fdf4;
            color: #22c55e;
        }
        
        .uploaded-file-details {
            min-width: 0;
        }
        
        .uploaded-file-name {
            font-size: 14px;
            font-weight: 500;
            color: #374151;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .uploaded-file-size {
            font-size: 12px;
            color: #9ca3af;
        }
        
        .uploaded-file-remove {
            background: none;
            border: none;
            color: #ef4444;
            cursor: pointer;
            padding: 4px;
            border-radius: 4px;
            transition: background-color 0.2s;
        }
        
        .uploaded-file-remove:hover {
            background-color: #fef2f2;
        }
    </style>
    
    <script>
    // Document Upload Functionality
    (function() {
        const uploadArea = document.getElementById('documentUploadArea');
        const fileInput = document.getElementById('companyDocumentsInput');
        const filesList = document.getElementById('uploadedFilesList');
        const errorSpan = document.getElementById('documentError');
        
        const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5MB
        const ALLOWED_TYPES = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];
        const ALLOWED_EXTENSIONS = ['.pdf', '.jpg', '.jpeg', '.png'];
        
        let uploadedFiles = [];
        
        if (!uploadArea || !fileInput) return;
        
        // Drag and Drop events
        uploadArea.addEventListener('dragover', function(e) {
            e.preventDefault();
            this.classList.add('drag-over');
        });
        
        uploadArea.addEventListener('dragleave', function(e) {
            e.preventDefault();
            this.classList.remove('drag-over');
        });
        
        uploadArea.addEventListener('drop', function(e) {
            e.preventDefault();
            this.classList.remove('drag-over');
            handleFiles(e.dataTransfer.files);
        });
        
        fileInput.addEventListener('change', function() {
            handleFiles(this.files);
        });
        
        function handleFiles(files) {
            errorSpan.textContent = '';
            
            for (let file of files) {
                // Check file type
                const ext = '.' + file.name.split('.').pop().toLowerCase();
                if (!ALLOWED_EXTENSIONS.includes(ext)) {
                    errorSpan.textContent = `Geçersiz dosya türü: ${file.name}. Sadece PDF, JPG, PNG dosyaları yüklenebilir.`;
                    continue;
                }
                
                // Check file size
                if (file.size > MAX_FILE_SIZE) {
                    errorSpan.textContent = `Dosya çok büyük: ${file.name}. Maksimum dosya boyutu 5MB'dır.`;
                    continue;
                }
                
                // Check if already added
                if (uploadedFiles.some(f => f.name === file.name && f.size === file.size)) {
                    continue;
                }
                
                uploadedFiles.push(file);
                renderFileItem(file);
            }
            
            updateFileInput();
        }
        
        function renderFileItem(file) {
            const ext = file.name.split('.').pop().toLowerCase();
            const isPdf = ext === 'pdf';
            const iconClass = isPdf ? 'pdf' : 'image';
            const iconName = isPdf ? 'file-text' : 'image';
            const fileSize = formatFileSize(file.size);
            
            const itemHtml = `
                <div class="uploaded-file-item" data-filename="${file.name}" data-filesize="${file.size}">
                    <div class="uploaded-file-info">
                        <div class="uploaded-file-icon ${iconClass}">
                            <i data-lucide="${iconName}" style="width: 18px; height: 18px;"></i>
                        </div>
                        <div class="uploaded-file-details">
                            <div class="uploaded-file-name">${file.name}</div>
                            <div class="uploaded-file-size">${fileSize}</div>
                        </div>
                    </div>
                    <button type="button" class="uploaded-file-remove" onclick="removeUploadedFile('${file.name}', ${file.size})">
                        <i data-lucide="x" style="width: 18px; height: 18px;"></i>
                    </button>
                </div>
            `;
            
            filesList.insertAdjacentHTML('beforeend', itemHtml);
            lucide.createIcons();
        }
        
        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }
        
        function updateFileInput() {
            // Create a new DataTransfer to update the file input
            const dt = new DataTransfer();
            uploadedFiles.forEach(file => dt.items.add(file));
            fileInput.files = dt.files;
        }
        
        // Global function to remove file
        window.removeUploadedFile = function(name, size) {
            uploadedFiles = uploadedFiles.filter(f => !(f.name === name && f.size === size));
            
            const item = filesList.querySelector(`[data-filename="${name}"][data-filesize="${size}"]`);
            if (item) item.remove();
            
            updateFileInput();
            errorSpan.textContent = '';
        };
    })();
    </script>
</body>
</html>

