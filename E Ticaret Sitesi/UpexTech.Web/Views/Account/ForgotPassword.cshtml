@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UpexTech</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-page">
    <div class="d-flex align-items-center justify-content-center" style="min-height: 100vh; padding: 1rem;">
        <div class="login-card login-card-form" style="max-width: 450px;">
            
            @* Geri Butonu *@
            <div class="mb-4">
                <a href="/Account/Login" class="login-back-link">
                    <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
                    <span>Giriş Sayfasına Dön</span>
                </a>
            </div>

            @* Logo *@
            <div class="text-center mb-4">
                <a href="/">
                    <img src="~/images/upex-logo.png" alt="UpexTech" class="login-logo">
                </a>
            </div>

            @* Başlık *@
            <div class="text-center mb-4">
                <div class="login-type-icon customer mx-auto mb-3" style="width: 60px; height: 60px;">
                    <i data-lucide="key" style="width: 28px; height: 28px;"></i>
                </div>
                <h1 class="fs-4 fw-bold text-dark">Şifremi Unuttum</h1>
                <p class="text-muted small">E-posta adresinizi girin, şifre sıfırlama bağlantısı gönderelim.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                    <i data-lucide="check-circle" style="width: 20px; height: 20px;" class="me-2"></i>
                    <div>@Model.SuccessMessage</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i data-lucide="alert-circle" style="width: 20px; height: 20px;" class="me-2"></i>
                    <div>@Model.ErrorMessage</div>
                </div>
            }

            @* Form *@
            <form asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <label asp-for="Email" class="form-label small fw-medium"></label>
                    <div class="form-input-icon">
                        <i data-lucide="mail" style="width: 20px; height: 20px;"></i>
                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn w-100 py-2 mb-3 text-white fw-medium" 
                        style="background-color: var(--primary-color);">
                    <i data-lucide="send" style="width: 18px; height: 18px;" class="me-2"></i>Şifre Sıfırlama Linki Gönder
                </button>

                <div class="text-center">
                    <span class="text-muted small">Şifrenizi hatırladınız mı?</span>
                    <a href="/Account/Login" class="small text-decoration-none fw-medium" style="color: var(--primary-color);">
                        Giriş Yap
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Initialize Lucide Icons -->
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
