@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
    var loginType = ViewBag.LoginType as string ?? Context.Request.Query["type"].ToString();
    var showSelection = string.IsNullOrEmpty(loginType);
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UpexTech</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-page">
    <div class="d-flex align-items-center justify-content-center" style="min-height: 100vh; padding: 1rem;">
        <div class="login-card @(showSelection ? "login-card-selection" : "login-card-form")">
            
            @* Geri Butonu *@
            <div class="mb-4">
                @if (showSelection)
                {
                    <a href="/" class="login-back-link">
                        <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
                        <span>Ana Sayfaya Dön</span>
                    </a>
                }
                else
                {
                    <a href="/Account/Login" class="login-back-link">
                        <i data-lucide="arrow-left" style="width: 20px; height: 20px;"></i>
                        <span>Geri Dön</span>
                    </a>
                }
            </div>

            @* Logo *@
            <div class="text-center mb-4">
                <a href="/">
                    <img src="~/images/upex-logo.png" alt="UpexTech" class="login-logo">
                </a>
            </div>

            @if (showSelection)
            {
                @* Hesap Tipi Seçimi *@
                <div class="text-center mb-4">
                    <h1 class="fs-3 fw-bold text-dark mb-2">Giriş Yap</h1>
                    <p class="text-muted">Hesap tipinizi seçin</p>
                </div>

                <div class="row g-4">
                    @* Bireysel Müşteri *@
                    <div class="col-md-6">
                        <a href="/Account/Login?type=customer" class="login-type-card d-block h-100">
                            <div class="login-type-icon customer">
                                <i data-lucide="user" style="width: 32px; height: 32px;"></i>
                            </div>
                            <h5 class="text-dark fw-semibold mb-2">Bireysel Müşteri</h5>
                            <p class="text-muted small mb-0">Kişisel hesabınızla giriş yapın</p>
                        </a>
                    </div>
                    
                    @* Bayi *@
                    <div class="col-md-6">
                        <a href="/Account/Login?type=dealer" class="login-type-card dealer d-block h-100">
                            <div class="login-type-icon dealer">
                                <i data-lucide="building-2" style="width: 32px; height: 32px;"></i>
                            </div>
                            <h5 class="text-dark fw-semibold mb-2">Bayi</h5>
                            <p class="text-muted small mb-0">Bayi hesabınızla giriş yapın</p>
                        </a>
                    </div>
                </div>

                <div class="text-center mt-4 pt-3">
                    <span class="text-muted">Hesabınız yok mu?</span>
                    <a href="/Account/Register" class="text-decoration-none fw-medium ms-1" style="color: var(--primary-color);">Kayıt Ol</a>
                </div>
            }
            else
            {
                @* Giriş Formu *@
                <div class="text-center mb-4">
                    @if (loginType == "dealer")
                    {
                        <div class="login-type-icon dealer mx-auto mb-3" style="width: 60px; height: 60px;">
                            <i data-lucide="building-2" style="width: 28px; height: 28px;"></i>
                        </div>
                        <h1 class="fs-4 fw-bold text-dark">Bayi Girişi</h1>
                        <p class="text-muted small">Bayi hesabınızla giriş yapın</p>
                    }
                    else
                    {
                        <div class="login-type-icon customer mx-auto mb-3" style="width: 60px; height: 60px;">
                            <i data-lucide="user" style="width: 28px; height: 28px;"></i>
                        </div>
                        <h1 class="fs-4 fw-bold text-dark">Bireysel Müşteri Girişi</h1>
                        <p class="text-muted small">Kişisel hesabınızla giriş yapın</p>
                    }
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert-success mb-4">
                        <i data-lucide="check-circle" style="width: 20px; height: 20px;"></i>
                        @TempData["SuccessMessage"]
                    </div>
                }

                @* Form *@
                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" name="loginType" value="@loginType" />
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-medium"></label>
                        <div class="form-input-icon">
                            <i data-lucide="mail" style="width: 20px; height: 20px;"></i>
                            <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-medium"></label>
                        <div class="form-input-icon">
                            <i data-lucide="lock" style="width: 20px; height: 20px;"></i>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small">Beni Hatırla</label>
                        </div>
                        <a href="/Account/ForgotPassword" class="small text-decoration-none" style="color: var(--primary-color);">Şifremi Unuttum</a>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert-error mb-4">
                            <i data-lucide="alert-circle" style="width: 20px; height: 20px;"></i>
                            <p>@Model.ErrorMessage</p>
                        </div>
                    }

                    <button type="submit" class="btn w-100 py-2 mb-3 text-white fw-medium" 
                            style="background-color: @(loginType == "dealer" ? "var(--green-600)" : "var(--primary-color)");">
                        <i data-lucide="log-in" style="width: 18px; height: 18px;" class="me-2"></i>Giriş Yap
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">Hesabınız yok mu?</span>
                        @if (loginType == "dealer")
                        {
                            <a href="/Account/Register?dealer=true" class="small text-decoration-none fw-medium" style="color: var(--green-600);">
                                Bayi Başvurusu Yap
                            </a>
                        }
                        else
                        {
                            <a href="/Account/Register" class="small text-decoration-none fw-medium" style="color: var(--primary-color);">
                                Üye Ol
                            </a>
                        }
                    </div>
                </form>
            }
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Initialize Lucide Icons -->
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
