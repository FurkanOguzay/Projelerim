<script>
// Footer Accordion Functionality
document.querySelectorAll('.accordion-header').forEach(header => {
    header.addEventListener('click', function() {
        const accordion = this.closest('.footer-accordion');
        const content = accordion.querySelector('.accordion-content');
        const icon = this.querySelector('[data-lucide="chevron-down"]');
        
        // Close other accordions
        document.querySelectorAll('.footer-accordion').forEach(other => {
            if (other !== accordion) {
                other.querySelector('.accordion-content').classList.remove('active');
                other.querySelector('.accordion-header').classList.remove('active');
            }
        });
        
        // Toggle current
        content.classList.toggle('active');
        this.classList.toggle('active');
    });
});
</script>

