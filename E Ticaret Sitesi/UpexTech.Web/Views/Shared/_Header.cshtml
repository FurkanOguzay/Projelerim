                    </ul>
                </div>
                <div class="mega-menu-section">
                    <h4>Akıllı Bileklikler</h4>
                    <ul>
                        <li><a href="/Catalog?search=Fitness+Takip">Fitness Takip</a></li>
                        <li><a href="/Catalog?search=Kalp+Ritmi">Kalp Ritmi İzleme</a></li>
                        <li><a href="/Catalog?search=Uyku+Takip">Uyku Takibi</a></li>
                        <li><a href="/Catalog?search=Adım+Sayar">Adım Sayar</a></li>
                        <li><a href="/Catalog?search=Suya+Dayanıklı">Suya Dayanıklı</a></li>
                    </ul>
                </div>
                <div class="mega-menu-section">
                    <h4>Aksesuarlar</h4>
                    <ul>
                        <li><a href="/Catalog?search=Saat+Kordon">Saat Kordonları</a></li>
                        <li><a href="/Catalog?search=Saat+Ekran+Koruyucu">Ekran Koruyucular</a></li>
                        <li><a href="/Catalog?search=Şarj+Stand">Şarj Standları</a></li>
                        <li><a href="/Catalog?search=Yedek+Kayış">Yedek Kayışlar</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Karşılaştırma Floating Bar -->
<div id="compareBar" class="compare-floating-bar" style="display: none;">
    <div class="container d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <i data-lucide="arrow-left-right" style="width: 20px; height: 20px;"></i>
            <span id="compareCount">0</span> ürün karşılaştırılıyor
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="clearCompare()">
                <i data-lucide="trash-2" style="width: 16px; height: 16px;"></i> Temizle
            </button>
            <button class="btn btn-light btn-sm" onclick="openCompareModal()">
                <i data-lucide="eye" style="width: 16px; height: 16px;"></i> Karşılaştır
            </button>
        </div>
    </div>
</div>

<!-- Karşılaştırma Modal -->
<div class="modal fade" id="compareModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i data-lucide="arrow-left-right" style="width: 20px; height: 20px;"></i>
                    Ürün Karşılaştırma
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="compareContent" class="compare-table-container">
                    <!-- Karşılaştırma içeriği JS ile doldurulacak -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-outline-danger" onclick="clearCompare()">
                    <i data-lucide="trash-2" style="width: 16px; height: 16px;"></i> Listeyi Temizle
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize Lucide icons
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
        
        // Mega Menu
        const categoriesBtn = document.getElementById('categoriesBtn');
        const megaMenuOverlay = document.getElementById('megaMenuOverlay');
        const megaMenuPanel = document.getElementById('megaMenuPanel');
        const categoryBtns = document.querySelectorAll('.mega-menu-category-btn');
        const subcategories = document.querySelectorAll('.mega-menu-subcategory');
        
        // Toggle Mega Menu
        if (categoriesBtn && megaMenuPanel) {
            categoriesBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                megaMenuOverlay.classList.toggle('show');
                megaMenuPanel.classList.toggle('show');
                // Close other dropdowns
                if (accountDropdown) accountDropdown.classList.remove('show');
                if (cartDropdown) cartDropdown.classList.remove('show');
            });
        }
        
        // Close Mega Menu on overlay click
        if (megaMenuOverlay) {
            megaMenuOverlay.addEventListener('click', function() {
                megaMenuOverlay.classList.remove('show');
                megaMenuPanel.classList.remove('show');
            });
        }
        
        // Category hover - show subcategories
        categoryBtns.forEach(btn => {
            btn.addEventListener('mouseenter', function() {
                const categoryId = this.getAttribute('data-category');
                
                // Remove active from all buttons
                categoryBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                // Hide all subcategories
                subcategories.forEach(sub => sub.style.display = 'none');
                
                // Show selected subcategory
                const targetSub = document.getElementById(categoryId);
                if (targetSub) {
                    targetSub.style.display = 'block';
                }
            });
        });
        
        // Account Dropdown - with timeout for better UX
        const accountContainer = document.getElementById('accountContainer');
        const accountDropdown = document.getElementById('accountDropdown');
        let accountTimeout;
        
        if (accountContainer && accountDropdown) {
            accountContainer.addEventListener('mouseenter', function() {
                clearTimeout(accountTimeout);
                accountDropdown.classList.add('show');
            });
            accountContainer.addEventListener('mouseleave', function() {
                accountTimeout = setTimeout(function() {
                    accountDropdown.classList.remove('show');
                }, 150);
            });
            accountDropdown.addEventListener('mouseenter', function() {
                clearTimeout(accountTimeout);
            });
            accountDropdown.addEventListener('mouseleave', function() {
                accountTimeout = setTimeout(function() {
                    accountDropdown.classList.remove('show');
                }, 150);
            });
        }
        
        // Cart Dropdown - with timeout for better UX
        const cartContainer = document.getElementById('cartContainer');
        const cartDropdown = document.getElementById('cartDropdown');
        let cartTimeout;
        
        if (cartContainer && cartDropdown) {
            cartContainer.addEventListener('mouseenter', function() {
                clearTimeout(cartTimeout);
                cartDropdown.classList.add('show');
                loadCartPreview();
            });
            cartContainer.addEventListener('mouseleave', function() {
                cartTimeout = setTimeout(function() {
                    cartDropdown.classList.remove('show');
                }, 150);
            });
            cartDropdown.addEventListener('mouseenter', function() {
                clearTimeout(cartTimeout);
            });
            cartDropdown.addEventListener('mouseleave', function() {
                cartTimeout = setTimeout(function() {
                    cartDropdown.classList.remove('show');
                }, 150);
            });
        }
        
        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (categoriesDropdown && !categoriesBtn.contains(e.target)) {
                categoriesDropdown.classList.remove('show');
            }
        });
        
        // Load cart count on page load
        loadCartCount();
        
        // Search Autocomplete + History
        const searchInput = document.getElementById('searchInput');
        const searchAutocomplete = document.getElementById('searchAutocomplete');
        const searchHistory = document.getElementById('searchHistory');
        const searchHistoryItems = document.getElementById('searchHistoryItems');
        const clearSearchHistoryBtn = document.getElementById('clearSearchHistory');
        let searchTimeout;
        
        // Search History Functions
        function getSearchHistory() {
            const history = localStorage.getItem('searchHistory');
            return history ? JSON.parse(history) : [];
        }
        
        function saveSearchHistory(query) {
            if (!query || query.length < 2) return;
            let history = getSearchHistory();
            // Remove duplicate if exists
            history = history.filter(item => item.toLowerCase() !== query.toLowerCase());
            // Add to start
            history.unshift(query);
            // Keep only last 10 searches
            history = history.slice(0, 10);
            localStorage.setItem('searchHistory', JSON.stringify(history));
        }
        
        function renderSearchHistory() {
            const history = getSearchHistory();
            if (history.length === 0) {
                searchHistory.classList.remove('show');
                return;
            }
            
            searchHistoryItems.innerHTML = history.map(item => `
                <a href="/Catalog?search=${encodeURIComponent(item)}" class="search-history-item">
                    <i data-lucide="search" style="width: 14px; height: 14px; color: var(--gray-400);"></i>
                    <span>${item}</span>
                </a>
            `).join('');
            
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }
        
        function showSearchHistory() {
            const history = getSearchHistory();
            if (history.length > 0 && searchInput.value.trim().length < 2) {
                renderSearchHistory();
                searchHistory.classList.add('show');
                searchAutocomplete.classList.remove('show');
            }
        }
        
        function hideSearchHistory() {
            searchHistory.classList.remove('show');
        }
        
        // Clear search history
        if (clearSearchHistoryBtn) {
            clearSearchHistoryBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                localStorage.removeItem('searchHistory');
                hideSearchHistory();
            });
        }
        
        if (searchInput && searchAutocomplete) {
            // Save search on form submit
            searchInput.closest('form').addEventListener('submit', function() {
                const query = searchInput.value.trim();
                saveSearchHistory(query);
            });
            
            searchInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                const query = this.value.trim();
                
                // Hide history when typing
                if (query.length >= 2) {
                    hideSearchHistory();
                }
                
                if (query.length < 2) {
                    searchAutocomplete.classList.remove('show');
                    searchAutocomplete.innerHTML = '';
                    showSearchHistory();
                    return;
                }
                
                searchTimeout = setTimeout(() => {
                    fetch('/Catalog/SearchSuggestions?query=' + encodeURIComponent(query))
                        .then(response => response.json())
                        .then(data => {
                            if (data.suggestions && data.suggestions.length > 0) {
                                searchAutocomplete.innerHTML = data.suggestions.map(item => `
                                    <a href="/Catalog/Details/${item.id}" class="search-autocomplete-item">
                                        <img src="/images/${item.image || 'phone1.png'}" alt="${item.name}">
                                        <div class="item-info">
                                            <div class="item-name">${item.name}</div>
                                            <div class="item-meta">${item.brand || ''} ${item.category ? '• ' + item.category : ''}</div>
                                        </div>
                                        <div class="item-price">₺${item.price.toLocaleString('tr-TR')}</div>
                                    </a>
                                `).join('');
                                searchAutocomplete.classList.add('show');
                            } else {
                                searchAutocomplete.classList.remove('show');
                            }
                        })
                        .catch(() => searchAutocomplete.classList.remove('show'));
                }, 300);
            });
            
            // Hide dropdowns on blur
            searchInput.addEventListener('blur', function() {
                setTimeout(() => {
                    searchAutocomplete.classList.remove('show');
                    hideSearchHistory();
                }, 200);
            });
            
            // Show history on focus if no query
            searchInput.addEventListener('focus', function() {
                const query = this.value.trim();
                if (query.length < 2) {
                    showSearchHistory();
                } else if (searchAutocomplete.innerHTML.trim()) {
                    searchAutocomplete.classList.add('show');
                }
            });
        }
    });
    
    function loadCartCount() {
        fetch('/Cart/GetCount')
            .then(response => {
                if (response.ok) return response.json();
                return { count: 0 };
            })
            .then(data => {
                const badge = document.getElementById('cartBadge');
                if (badge) {
                    badge.textContent = data.count || 0;
                    badge.style.display = (data.count && data.count > 0) ? 'flex' : 'none';
                }
            })
            .catch(err => {
                console.log('Cart count error:', err);
            });
    }
    
    function loadCartPreview() {
        fetch('/Cart/GetPreview')
            .then(response => {
                if (response.ok) return response.json();
                return { items: [], total: 0 };
            })
            .then(data => {
                const container = document.getElementById('cartDropdownItems');
                const totalEl = document.getElementById('cartTotal');
                
                if (container && data.items && data.items.length > 0) {
                    container.innerHTML = data.items.map(item => `
                        <div class="cart-dropdown-item">
                            <img src="${item.image || '/images/phone1.png'}" alt="${item.name}">
                            <div class="item-details">
                                <h4 class="item-name">${item.name}</h4>
                                <p class="item-qty">${item.quantity} adet</p>
                                <p class="item-price">₺${item.price.toLocaleString('tr-TR')}</p>
                            </div>
                            <button class="remove-btn" onclick="event.stopPropagation(); removeFromCart(${item.productId})">
                                <i data-lucide="x" style="width: 18px; height: 18px;"></i>
                            </button>
                        </div>
                    `).join('');
                    if (typeof lucide !== 'undefined') {
                        lucide.createIcons();
                    }
                } else if (container) {
                    container.innerHTML = '<div class="p-4 text-center text-muted">Sepetiniz boş</div>';
                }
                
                if (totalEl) {
                    totalEl.textContent = '₺' + (data.total || 0).toLocaleString('tr-TR');
                }
            })
            .catch(err => {
                console.log('Cart preview error:', err);
            });
    }
    
    function removeFromCart(productId) {
        fetch('/Cart/Remove', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'productId=' + productId
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                loadCartCount();
                loadCartPreview();
            }
        });
    }
    
    // ========== MOBILE MENU FUNCTIONALITY ==========
    (function() {
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileSideMenu = document.getElementById('mobileSideMenu');
        const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
        const mobileMenuClose = document.getElementById('mobileMenuClose');
        const mobileMenuMain = document.getElementById('mobileMenuMain');
        
        // Open mobile menu
        if (mobileMenuBtn && mobileSideMenu && mobileMenuOverlay) {
            mobileMenuBtn.addEventListener('click', function() {
                mobileSideMenu.classList.add('active');
                mobileMenuOverlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            });
        }
        
        // Close mobile menu
        function closeMobileMenu() {
            if (mobileSideMenu) mobileSideMenu.classList.remove('active');
            if (mobileMenuOverlay) mobileMenuOverlay.classList.remove('active');
            document.body.style.overflow = '';
            // Reset to main menu
            document.querySelectorAll('.mobile-submenu').forEach(sub => sub.classList.remove('active'));
            if (mobileMenuMain) mobileMenuMain.classList.remove('hidden');
        }
        
        if (mobileMenuOverlay) {
            mobileMenuOverlay.addEventListener('click', closeMobileMenu);
        }
        
        if (mobileMenuClose) {
            mobileMenuClose.addEventListener('click', closeMobileMenu);
        }
        
        // Drill-down navigation - open submenu
        document.querySelectorAll('.mobile-menu-item[data-submenu]').forEach(item => {
            item.addEventListener('click', function() {
                const submenuId = this.getAttribute('data-submenu');
                const submenu = document.getElementById(submenuId);
                if (submenu && mobileMenuMain) {
                    mobileMenuMain.classList.add('hidden');
                    submenu.classList.add('active');
                }
            });
        });
        
        // Back button - return to main menu
        document.querySelectorAll('.mobile-menu-back').forEach(backBtn => {
            backBtn.addEventListener('click', function() {
                const submenu = this.closest('.mobile-submenu');
                if (submenu && mobileMenuMain) {
                    submenu.classList.remove('active');
                    mobileMenuMain.classList.remove('hidden');
                }
            });
        });
        
        // Update mobile cart badge
        function updateMobileCartBadge() {
            fetch('/Cart/GetCount')
                .then(response => response.ok ? response.json() : { count: 0 })
                .then(data => {
                    const badge = document.getElementById('mobileCartBadge');
                    if (badge) {
                        badge.textContent = data.count || 0;
                        badge.style.display = (data.count && data.count > 0) ? 'flex' : 'none';
                    }
                })
                .catch(() => {});
        }
        updateMobileCartBadge();
    })();
</script>
