@using System.Security.Claims
@inject UpexTech.Business.Services.IBrandService BrandService
@inject UpexTech.Business.Services.ICategoryService CategoryService

@{
    var isLoggedIn = User.Identity?.IsAuthenticated ?? false;
    var userName = User.Identity?.Name ?? "";
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var isDealer = userRole == "B2B";
    
    // Get brands and categories from database
    var allBrands = await BrandService.GetAllBrandsAsync();
    var topBrands = allBrands.Where(b => b.IsActive).Take(5).ToList();
}

<header class="main-header">
    <div class="container">
        <!-- ========== MOBILE HEADER (Only visible on mobile < 992px) ========== -->
        <div class="mobile-header">
            <!-- Mobile Top Bar -->
            <div class="mobile-top-bar">
                <!-- Left: Hamburger + Logo -->
                <div class="mobile-left-group">
                    <button type="button" class="mobile-menu-btn" id="mobileMenuBtn">
                        <i data-lucide="menu" style="width: 24px; height: 24px;"></i>
                    </button>
                    <a href="/" class="mobile-logo">
                        <img src="~/images/upex-logo.png" alt="UpexTech">
                    </a>
                </div>
                
                <!-- Right: Three Icons -->
                <div class="mobile-actions">
                    @if (isLoggedIn)
                    {
                        <a href="/Favorites" class="mobile-action-btn">
                            <i data-lucide="heart" style="width: 22px; height: 22px;"></i>
                        </a>
                        <a href="/MyAccount" class="mobile-action-btn">
                            <i data-lucide="user" style="width: 22px; height: 22px;"></i>
                        </a>
                        <a href="/Cart" class="mobile-action-btn mobile-cart-btn">
                            <i data-lucide="shopping-cart" style="width: 22px; height: 22px;"></i>
                            <span class="mobile-cart-badge" id="mobileCartBadge" style="display: none;">0</span>
                        </a>
                    }
                    else
                    {
                        <a href="/Account/Login" class="mobile-action-btn">
                            <i data-lucide="heart" style="width: 22px; height: 22px;"></i>
                        </a>
                        <a href="/Account/Login" class="mobile-action-btn">
                            <i data-lucide="user" style="width: 22px; height: 22px;"></i>
                        </a>
                        <a href="/Account/Login" class="mobile-action-btn">
                            <i data-lucide="shopping-cart" style="width: 22px; height: 22px;"></i>
                        </a>
                    }
                </div>
            </div>
            
            <!-- Mobile Search Bar - Full Width Below Top Bar -->
            <div class="mobile-search-bar">
                <form asp-controller="Catalog" asp-action="Index" method="get" class="mobile-search-form">
                    <input type="text" name="search" class="mobile-search-input" placeholder="Ürün, marka veya kategori ara..." autocomplete="off">
                    <button type="submit" class="mobile-search-submit">
                        <i data-lucide="search" style="width: 20px; height: 20px;"></i>
                    </button>
                </form>
            </div>
        </div>
        
        <!-- ========== DESKTOP HEADER (Hidden on mobile) ========== -->
        <!-- Üst Satır: Logo, Arama, Sağ İkonlar -->
        <div class="py-3 desktop-header-row">
            <div class="d-flex align-items-center justify-content-between gap-4">
                <!-- Logo -->
                <a href="/" class="d-flex align-items-center flex-shrink-0">
                    <img src="~/images/upex-logo.png" alt="UpexTech" class="header-logo">
                </a>

                <!-- Orta - Arama -->
                <div class="flex-grow-1" style="max-width: 550px;">
                    <form asp-controller="Catalog" asp-action="Index" method="get" class="search-container">
                        <input type="text" name="search" id="searchInput" class="search-input" placeholder="Ürün, marka veya kategori ara..." autocomplete="off">
                        <button type="submit" class="search-btn">
                            <i data-lucide="search" style="width: 24px; height: 24px;"></i>
                        </button>
                        <div id="searchAutocomplete" class="search-autocomplete"></div>
                        <div id="searchHistory" class="search-history-dropdown">
                            <div class="search-history-header">
                                <span><i data-lucide="clock" style="width: 16px; height: 16px;"></i> Son Aramalar</span>
                                <button type="button" id="clearSearchHistory" class="search-history-clear">Temizle</button>
                            </div>
                            <div id="searchHistoryItems" class="search-history-items"></div>
                        </div>
                    </form>
                </div>

                <!-- Sağ Taraf - Hesap, Favoriler, Sepet -->
                <div class="d-flex gap-2">
                    @if (isLoggedIn)
                    {
                        <!-- Hesabım -->
                        <div class="position-relative" id="accountContainer">
                            <a href="/MyAccount" class="header-action-btn" id="accountBtn">
                                <i data-lucide="user" style="width: 24px; height: 24px;"></i>
                                <span>Hesabım</span>
                                @if (isDealer)
                                {
                                    <span class="dealer-badge">Bayi</span>
                                }
                            </a>
                            
                            <div class="account-dropdown" id="accountDropdown">
                                <a href="/MyAccount/Orders">Siparişlerim</a>
                                <a href="/MyAccount/Profile">Değerlendirmelerim</a>
                                <a href="/MyAccount/Profile">Kullanıcı Bilgilerim</a>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="logout-btn">Çıkış Yap</button>
                                </form>
                            </div>
                        </div>
                        
                        <!-- Favorilerim -->
                        <a href="/Favorites" class="header-action-btn">
                            <i data-lucide="heart" style="width: 24px; height: 24px;"></i>
                            <span>Favorilerim</span>
                        </a>
                        
                        <!-- Sepetim -->
                        <div class="position-relative" id="cartContainer">
                            <button class="header-action-btn" type="button" id="cartBtn" onclick="window.location.href='/Cart'">
                                <i data-lucide="shopping-cart" style="width: 24px; height: 24px;"></i>
                                <span>Sepetim</span>
                                <span class="badge cart-badge" id="cartBadge" style="display: none;">0</span>
                            </button>
                            
                            <div class="cart-dropdown" id="cartDropdown">
                                <div class="cart-dropdown-items" id="cartDropdownItems">
                                    <!-- Cart items will be loaded via JS -->
                                </div>
                                <div class="cart-dropdown-footer">
                                    <div class="cart-dropdown-total">
                                        <span>Toplam:</span>
                                        <span class="total-amount" id="cartTotal">₺0</span>
                                    </div>
                                    <div class="cart-dropdown-actions">
                                        <a href="/Cart" class="btn btn-outline">Sepete Git</a>
                                        <a href="/Checkout" class="btn btn-solid">Siparişi Tamamla</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Giriş Yap -->
                        <a href="/Account/Login" class="header-action-btn">
                            <i data-lucide="log-in" style="width: 24px; height: 24px;"></i>
                            <span>Giriş Yap</span>
                        </a>
                        
                        <!-- Favorilerim (Login'e yönlendir) -->
                        <a href="/Account/Login" class="header-action-btn">
                            <i data-lucide="heart" style="width: 24px; height: 24px;"></i>
                            <span>Favorilerim</span>
                        </a>
                        
                        <!-- Sepetim (Login'e yönlendir) -->
                        <a href="/Account/Login" class="header-action-btn">
                            <i data-lucide="shopping-cart" style="width: 24px; height: 24px;"></i>
                            <span>Sepetim</span>
                        </a>
                    }
                    
                    <!-- Mobil Menü Butonu -->
                    <button class="header-action-btn d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu">
                        <i data-lucide="menu" style="width: 24px; height: 24px;"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Alt Satır: Tüm Kategoriler + Marka Linkleri -->
        <div class="category-nav-bar py-2 border-top" style="border-color: #e5e7eb !important;">
            <div class="d-flex align-items-center gap-4">
                <!-- Tüm Kategoriler Butonu -->
                <div class="position-relative">
                    <button class="categories-btn" type="button" id="categoriesBtn">
                        <i data-lucide="menu" style="width: 18px; height: 18px;"></i>
                        <span>Tüm Kategoriler</span>
                    </button>
                </div>
                
                <!-- Marka ve Kategori Linkleri -->
                <div class="d-flex gap-4 align-items-center">
                    @foreach (var brand in topBrands)
                    {
                        <a href="/Catalog?brandId=@brand.Id" class="category-nav-link">@brand.Name</a>
                    }
                    <a href="/Catalog?categoryId=2" class="category-nav-link">Ekran & Yedek Parça</a>
                    <a href="/Catalog?sort=popular" class="category-nav-link">Fırsatlar</a>
                </div>
            </div>
        </div>

        <!-- Mobil Menü -->
        <div class="collapse d-md-none border-top" id="mobileMenu">
            <nav class="py-3">
                <div class="d-flex flex-column gap-3">
                    <a href="/" class="text-dark text-decoration-none">Ana Sayfa</a>
                    <a href="/Catalog" class="text-dark text-decoration-none">Telefonlar</a>
                    <a href="/Catalog" class="text-dark text-decoration-none">Kategoriler</a>
                    <a href="/Home/About" class="text-dark text-decoration-none">Hakkımızda</a>
                    @if (isLoggedIn)
                    {
                        <a href="/MyAccount" class="text-dark text-decoration-none">Hesabım</a>
                        <a href="/Cart" class="text-dark text-decoration-none">Sepetim</a>
                    }
                </div>
            </nav>
        </div>
    </div>
</header>

