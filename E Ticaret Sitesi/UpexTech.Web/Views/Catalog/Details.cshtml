@model Product
@using UpexTech.Entity
@{
    ViewData["Title"] = Model.Name;
    var isLoggedIn = ViewBag.IsLoggedIn ?? false;
    var userRole = ViewBag.UserRole as UserRole?;
    var isB2B = userRole == UserRole.B2B;
    var userPriceList = ViewBag.UserPriceList as PriceList;
    var userEmail = ViewBag.UserEmail as string ?? "";
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<Product> ?? Enumerable.Empty<Product>();
    
    // Fiyat hesaplama fonksiyonu
    decimal CalculatePrice(Product product) {
        decimal defaultPrice = isB2B ? product.PriceB2B : product.PriceB2C;
        
        if (userPriceList == null) {
            return defaultPrice;
        }
        
        decimal basePrice = product.PurchasePrice > 0 ? product.PurchasePrice : defaultPrice;
        decimal calculatedPrice = basePrice * userPriceList.Factor;
        
        calculatedPrice = userPriceList.Rounding switch {
            RoundingMethod.Ending90 => Math.Floor(calculatedPrice) + 0.90m,
            RoundingMethod.Ending99 => Math.Floor(calculatedPrice) + 0.99m,
            RoundingMethod.NearestFive => Math.Round(calculatedPrice / 5) * 5,
            _ => Math.Round(calculatedPrice, 2)
        };
        
        return calculatedPrice > 0 ? calculatedPrice : defaultPrice;
    }
    
    var price = CalculatePrice(Model);
    
    // Get images - use product images if available, otherwise use main image
    var images = Model.Images?.OrderBy(i => i.DisplayOrder).ToList() ?? new List<ProductImage>();
    var hasMultipleImages = images.Count > 1;
    var mainImageUrl = images.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? images.FirstOrDefault()?.ImageUrl ?? Model.Image;
    
    // Get variations grouped by type
    var colorVariations = Model.Variations?.Where(v => v.VariationType == VariationType.Color).ToList() ?? new List<ProductVariation>();
    var capacityVariations = Model.Variations?.Where(v => v.VariationType == VariationType.Capacity).ToList() ?? new List<ProductVariation>();
    var hasVariations = colorVariations.Any() || capacityVariations.Any();
    
    // Parse technical specs from JSON
    var techSpecs = new Dictionary<string, string>();
    if (!string.IsNullOrEmpty(Model.TechnicalSpecs))
    {
        try
        {
            techSpecs = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(Model.TechnicalSpecs) ?? new Dictionary<string, string>();
        }
        catch { }
    }
}

<!-- Breadcrumb -->
<div class="bg-light py-3">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="/Catalog" class="text-decoration-none">Katalog</a></li>
                <li class="breadcrumb-item"><a href="/Catalog?categoryId=@Model.CategoryId" class="text-decoration-none">@Model.Category?.Name</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4">
    <div class="row">
        <!-- Image Gallery -->
        <div class="col-lg-5 mb-4">
            <div class="pdp-gallery">
                <!-- Main Image with Zoom -->
                <div class="pdp-main-image-container">
                    <div class="pdp-main-image" id="mainImageContainer">
                        @if (mainImageUrl != null && (mainImageUrl.StartsWith("http://") || mainImageUrl.StartsWith("https://")))
                        {
                            <img src="@mainImageUrl" alt="@Model.Name" id="mainImage" class="img-fluid">
                        }
                        else
                        {
                            <img src="~/images/@mainImageUrl" alt="@Model.Name" id="mainImage" class="img-fluid">
                        }
                        <div class="pdp-zoom-lens" id="zoomLens"></div>
                    </div>
                    <div class="pdp-zoom-result" id="zoomResult"></div>
                </div>

                <!-- Thumbnails -->
                @if (hasMultipleImages)
                {
                    <div class="pdp-thumbnails mt-3">
                        @foreach (var (image, index) in images.Select((img, i) => (img, i)))
                        {
                            var thumbUrl = image.ImageUrl.StartsWith("http") ? image.ImageUrl : Url.Content($"~/images/{image.ImageUrl}");
                            <button class="pdp-thumbnail @(index == 0 ? "active" : "")" 
                                    onclick="changeMainImage('@thumbUrl', this)"
                                    data-index="@index">
                                <img src="@thumbUrl" alt="@(image.AltText ?? Model.Name)">
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <!-- Brand & Category -->
                    <div class="mb-2">
                        <span class="badge bg-primary">@Model.Brand?.Name</span>
                        <span class="badge bg-secondary">@Model.Category?.Name</span>
                        @if (Model.SKU != null)
                        {
                            <span class="text-muted small ms-2">SKU: <span id="productSku">@Model.SKU</span></span>
                        }
                    </div>

                    <!-- Product Name -->
                    <h1 class="h3 fw-bold mb-3">@Model.Name</h1>

                    <!-- Rating -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="d-flex">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Floor(Model.Rating))
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-muted"></i>
                                }
                            }
                        </div>
                        <span class="text-muted">@Model.Rating / 5</span>
                        <span class="text-muted">(@Model.ReviewCount değerlendirme)</span>
                    </div>

                    <hr>

                    <!-- Variations -->
                    @if (hasVariations)
                    {
                        <div class="pdp-variations mb-4">
                            @if (colorVariations.Any())
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Renk Seçimi</label>
                                    <div class="pdp-color-swatches">
                                        @foreach (var color in colorVariations)
                                        {
                                            <button class="pdp-color-swatch @(color.Stock <= 0 ? "out-of-stock" : "")" 
                                                    style="background-color: @(color.ColorCode ?? "#ccc")"
                                                    data-variation-type="Color"
                                                    data-variation-value="@color.VariationValue"
                                                    data-stock="@color.Stock"
                                                    title="@color.VariationValue @(color.Stock <= 0 ? "(Stokta Yok)" : "")">
                                                @if (color.Stock <= 0)
                                                {
                                                    <i class="bi bi-x"></i>
                                                }
                                            </button>
                                        }
                                    </div>
                                    <small class="text-muted" id="selectedColor"></small>
                                </div>
                            }

                            @if (capacityVariations.Any())
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Kapasite Seçimi</label>
                                    <div class="pdp-capacity-options">
                                        @foreach (var capacity in capacityVariations)
                                        {
                                            <button class="pdp-capacity-btn @(capacity.Stock <= 0 ? "out-of-stock" : "")"
                                                    data-variation-type="Capacity"
                                                    data-variation-value="@capacity.VariationValue"
                                                    data-stock="@capacity.Stock">
                                                @capacity.VariationValue
                                                @if (capacity.Stock <= 0)
                                                {
                                                    <span class="badge bg-danger ms-1">Tükendi</span>
                                                }
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Price -->
                    @if (isLoggedIn)
                    {
                        <div class="mb-4" id="priceSection">
                            @if (userPriceList != null)
                            {
                                <span class="badge bg-info mb-2">@userPriceList.Name</span>
                                <div class="d-flex align-items-baseline gap-2">
                                    <span class="fs-2 fw-bold text-primary" id="currentPrice">@price.ToString("N0") ₺</span>
                                    @if (price != (isB2B ? Model.PriceB2B : Model.PriceB2C))
                                    {
                                        <span class="text-muted text-decoration-line-through">@((isB2B ? Model.PriceB2B : Model.PriceB2C).ToString("N0")) ₺</span>
                                    }
                                </div>
                            }
                            else if (isB2B)
                            {
                                <span class="badge bg-info mb-2">Bayi Fiyatı</span>
                                <div class="d-flex align-items-baseline gap-2">
                                    <span class="fs-2 fw-bold text-primary" id="currentPrice">@Model.PriceB2B.ToString("N0") ₺</span>
                                    <span class="text-muted text-decoration-line-through">@Model.PriceB2C.ToString("N0") ₺</span>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-secondary mb-2">Perakende Fiyatı</span>
                                <div class="fs-2 fw-bold" id="currentPrice">@Model.PriceB2C.ToString("N0") ₺</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="bi bi-lock me-2"></i>
                            Fiyatı görmek için <a href="/Account/Login" class="alert-link">giriş yapın</a> veya <a href="/Account/Register" class="alert-link">üye olun</a>.
                        </div>
                    }

                    <!-- Stock Status -->
                    <div class="mb-4" id="stockSection">
                        @if (Model.Stock > 10)
                        {
                            <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Stokta Var</span>
                        }
                        else if (Model.Stock > 0)
                        {
                            <span class="badge bg-warning text-dark fs-6"><i class="bi bi-exclamation-circle me-1"></i>Son @Model.Stock Adet!</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Stokta Yok</span>
                        }
                    </div>

                    <!-- Add to Cart / Notify Me -->
                    <div id="actionSection">
                        @if (isLoggedIn && Model.Stock > 0)
                        {
                            <div class="d-flex align-items-center gap-3 mb-4" id="addToCartSection">
                                <div class="d-flex align-items-center border rounded">
                                    <button class="btn btn-outline-secondary border-0 px-3" onclick="decreaseDetailQty()">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <input type="number" id="detail-qty" class="form-control border-0 text-center" 
                                           value="1" min="1" max="@Model.Stock" style="width: 60px;"
                                           onchange="validateDetailQty()">
                                    <button class="btn btn-outline-secondary border-0 px-3" onclick="increaseDetailQty()">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>
                                <button class="btn btn-primary btn-lg flex-grow-1" id="addToCartBtn" onclick="addToCartDetail(@Model.Id)">
                                    <i class="bi bi-cart-plus me-2"></i>Sepete Ekle
                                </button>
                                <button class="btn btn-outline-secondary btn-lg pdp-compare-btn" id="pdpCompareBtn" onclick="toggleCompareFromDetail(@Model.Id, '@Model.Name.Replace("'", "\\'")','@(mainImageUrl?.Replace("'", "\\'") ?? "")', '@(price.ToString("N0"))₺', '@Model.Rating.ToString("0.0")', '@(Model.Brand?.Name ?? "Belirtilmemiş")', '@(Model.Category?.Name ?? "Belirtilmemiş")', '@(Model.Stock > 0 ? "Stokta" : "Stokta Yok")')" title="Karşılaştırma Listesine Ekle">
                                    <i class="bi bi-arrow-left-right me-1"></i>Karşılaştır
                                </button>
                            </div>
                        }
                        else if (!isLoggedIn)
                        {
                            <a href="/Account/Login" class="btn btn-primary btn-lg w-100 mb-4">
                                <i class="bi bi-person-plus me-2"></i>Satın Almak İçin Giriş Yapın
                            </a>
                        }
                        else
                        {
                            <!-- Notify Me Section for out of stock -->
                            <div class="mb-4" id="notifyMeSection">
                                <div class="alert alert-info">
                                    <i class="bi bi-bell me-2"></i>
                                    <strong>Stokta yok!</strong> Ürün stoğa girdiğinde bildirim almak ister misiniz?
                                </div>
                                <div class="input-group">
                                    <input type="email" class="form-control" id="notifyEmail" placeholder="E-posta adresiniz" value="@userEmail">
                                    <button class="btn btn-warning" onclick="notifyWhenAvailable(@Model.Id)">
                                        <i class="bi bi-bell me-2"></i>Gelince Haber Ver
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Features / Trust Badges -->
                    <div class="pdp-trust-badges">
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <div class="pdp-badge">
                                    <i class="bi bi-truck text-primary"></i>
                                    <span>Ücretsiz Kargo</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="pdp-badge">
                                    <i class="bi bi-shield-check text-success"></i>
                                    <span>2 Yıl Garanti</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="pdp-badge">
                                    <i class="bi bi-arrow-repeat text-info"></i>
                                    <span>14 Gün İade</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="pdp-badge">
                                    <i class="bi bi-credit-card text-warning"></i>
                                    <span>Güvenli Ödeme</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="pdp-badge">
                                    <i class="bi bi-lightning-charge text-danger"></i>
                                    <span>Aynı Gün Kargo</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="pdp-badge">
                                    <i class="bi bi-patch-check text-primary"></i>
                                    <span>Orijinal Ürün</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="pdp-badge">
                                    <i class="bi bi-wallet2 text-success"></i>
                                    <span>Kolay Ödeme</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="pdp-badge">
                                    <i class="bi bi-headset text-info"></i>
                                    <span>7/24 Destek</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs: Description, Technical Specs, Shipping & Returns, Warranty -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <ul class="nav nav-tabs pdp-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="description-tab" data-bs-toggle="tab" data-bs-target="#description" type="button" role="tab">
                                <i class="bi bi-file-text me-2"></i>Ürün Açıklaması
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button" role="tab">
                                <i class="bi bi-gear me-2"></i>Teknik Özellikler
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="shipping-tab" data-bs-toggle="tab" data-bs-target="#shipping" type="button" role="tab">
                                <i class="bi bi-truck me-2"></i>Kargo & İade
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="warranty-tab" data-bs-toggle="tab" data-bs-target="#warranty" type="button" role="tab">
                                <i class="bi bi-shield-check me-2"></i>Garanti
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
                                <i class="bi bi-chat-left-text me-2"></i>Değerlendirmeler <span class="badge bg-primary">@Model.ReviewCount</span>
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content p-4">
                        <!-- Product Description Tab -->
                        <div class="tab-pane fade show active" id="description" role="tabpanel">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <div class="pdp-description">
                                    <p class="mb-4">@Model.Description</p>
                                    
                                    <h5 class="mb-3"><i class="bi bi-star-fill text-warning me-2"></i>Ürün Özellikleri</h5>
                                    <ul class="pdp-feature-list">
                                        <li><i class="bi bi-check-circle-fill text-success"></i> Yüksek kaliteli malzeme ve işçilik</li>
                                        <li><i class="bi bi-check-circle-fill text-success"></i> Uzun ömürlü kullanım garantisi</li>
                                        <li><i class="bi bi-check-circle-fill text-success"></i> Orijinal üretici garantisi</li>
                                        <li><i class="bi bi-check-circle-fill text-success"></i> Tüm cihazlarla %100 uyumluluk</li>
                                        <li><i class="bi bi-check-circle-fill text-success"></i> Profesyonel teknik destek</li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">Bu ürün için henüz açıklama eklenmemiş.</p>
                            }
                        </div>
                        
                        <!-- Technical Specs Tab -->
                        <div class="tab-pane fade" id="specs" role="tabpanel">
                            @if (techSpecs.Any())
                            {
                                <table class="table table-striped pdp-specs-table">
                                    <tbody>
                                        @foreach (var spec in techSpecs)
                                        {
                                            <tr>
                                                <th scope="row">@spec.Key</th>
                                                <td>@spec.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <!-- Default specs when no custom specs available -->
                                <table class="table table-striped pdp-specs-table">
                                    <tbody>
                                        <tr>
                                            <th scope="row">Marka</th>
                                            <td>@(Model.Brand?.Name ?? "Belirtilmemiş")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Kategori</th>
                                            <td>@(Model.Category?.Name ?? "Belirtilmemiş")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">SKU</th>
                                            <td>@(Model.SKU ?? "Belirtilmemiş")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Stok Durumu</th>
                                            <td>@(Model.Stock > 0 ? "Stokta" : "Stokta Yok")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Garanti Süresi</th>
                                            <td>24 Ay</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Menşei</th>
                                            <td>Türkiye</td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                        </div>
                        
                        <!-- Shipping & Returns Tab -->
                        <div class="tab-pane fade" id="shipping" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <h5 class="mb-3"><i class="bi bi-truck text-primary me-2"></i>Kargo Bilgileri</h5>
                                    <ul class="list-unstyled pdp-info-list">
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Ücretsiz Kargo:</strong> 250₺ üzeri siparişlerde</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Aynı Gün Kargo:</strong> 16:00'a kadar verilen siparişler</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Teslimat Süresi:</strong> 1-3 iş günü</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Kargo Takibi:</strong> SMS ve e-posta bildirimi</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Kapıda Ödeme:</strong> Tüm siparişlerde geçerli</li>
                                    </ul>
                                </div>
                                <div class="col-md-6 mb-4">
                                    <h5 class="mb-3"><i class="bi bi-arrow-repeat text-info me-2"></i>İade Koşulları</h5>
                                    <ul class="list-unstyled pdp-info-list">
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>İade Süresi:</strong> 14 gün içinde ücretsiz iade</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Koşulsuz İade:</strong> Açılmamış ürünlerde</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Değişim:</strong> Aynı veya farklı ürünle değişim</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Para İadesi:</strong> 3-5 iş günü içinde</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Ücretsiz Kargo:</strong> İade kargosunda</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                Detaylı bilgi için <a href="#" class="alert-link">Kargo ve İade Politikamızı</a> inceleyebilirsiniz.
                            </div>
                        </div>
                        
                        <!-- Warranty Tab -->
                        <div class="tab-pane fade" id="warranty" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <h5 class="mb-3"><i class="bi bi-shield-check text-success me-2"></i>Garanti Kapsamı</h5>
                                    <ul class="list-unstyled pdp-info-list">
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Süre:</strong> 24 ay resmi distribütör garantisi</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Üretim Hataları:</strong> Tam kapsam</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Yedek Parça:</strong> 5 yıl boyunca temin garantisi</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Teknik Servis:</strong> Türkiye geneli yetkili servis ağı</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i><strong>Hızlı Çözüm:</strong> Ortalama 5 iş günü</li>
                                    </ul>
                                </div>
                                <div class="col-md-6 mb-4">
                                    <h5 class="mb-3"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Garanti Dışı Durumlar</h5>
                                    <ul class="list-unstyled pdp-info-list">
                                        <li><i class="bi bi-x-circle text-danger me-2"></i>Fiziksel hasar ve düşürme</li>
                                        <li><i class="bi bi-x-circle text-danger me-2"></i>Sıvı teması</li>
                                        <li><i class="bi bi-x-circle text-danger me-2"></i>Yetkisiz onarım müdahalesi</li>
                                        <li><i class="bi bi-x-circle text-danger me-2"></i>Garanti etiketi sökülen ürünler</li>
                                        <li><i class="bi bi-x-circle text-danger me-2"></i>Yanlış kullanımdan kaynaklanan arızalar</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="alert alert-success">
                                <i class="bi bi-patch-check me-2"></i>
                                <strong>Orijinal Ürün Garantisi:</strong> Tüm ürünlerimiz orijinal ve resmi distribütör garantilidir.
                            </div>
                        </div>
                        
                        <!-- Reviews Tab -->
                        <div class="tab-pane fade" id="reviews" role="tabpanel">
                            @{
                                var reviews = ViewBag.Reviews as IEnumerable<Review> ?? Enumerable.Empty<Review>();
                                var ratingStats = ViewBag.RatingStats as (double AverageRating, int TotalCount, Dictionary<int, int> Distribution)?;
                                var hasUserReviewed = ViewBag.HasUserReviewed as bool? ?? false;
                            }
                            
                            <div class="row">
                                <!-- Rating Summary -->
                                <div class="col-md-4 mb-4">
                                    <div class="pdp-rating-summary">
                                        <div class="text-center mb-3">
                                            <div class="display-4 fw-bold text-primary">@(ratingStats?.AverageRating.ToString("0.0") ?? "0.0")</div>
                                            <div class="d-flex justify-content-center gap-1 mb-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    var avgRating = ratingStats?.AverageRating ?? 0;
                                                    if (i <= Math.Floor(avgRating))
                                                    {
                                                        <i class="bi bi-star-fill text-warning fs-5"></i>
                                                    }
                                                    else if (i == Math.Ceiling(avgRating) && avgRating % 1 >= 0.5)
                                                    {
                                                        <i class="bi bi-star-half text-warning fs-5"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star text-muted fs-5"></i>
                                                    }
                                                }
                                            </div>
                                            <div class="text-muted">@(ratingStats?.TotalCount ?? 0) değerlendirme</div>
                                        </div>
                                        
                                        <!-- Rating Distribution -->
                                        <div class="pdp-rating-bars">
                                            @if (ratingStats?.Distribution != null)
                                            {
                                                @for (int i = 5; i >= 1; i--)
                                                {
                                                    var count = ratingStats?.Distribution.ContainsKey(i) == true ? ratingStats.Value.Distribution[i] : 0;
                                                    var total = ratingStats?.TotalCount ?? 0;
                                                    var percentage = total > 0 ? (count * 100.0 / total) : 0;
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <span class="text-nowrap" style="width: 60px;">@i yıldız</span>
                                                        <div class="progress flex-grow-1" style="height: 10px;">
                                                            <div class="progress-bar bg-warning" style="width: @percentage%"></div>
                                                        </div>
                                                        <span class="text-muted" style="width: 30px;">@count</span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Review Form & List -->
                                <div class="col-md-8">
                                    <!-- Review Form -->
                                    @if (isLoggedIn && !hasUserReviewed)
                                    {
                                        <div class="card border-0 bg-light mb-4">
                                            <div class="card-body">
                                                <h5 class="card-title mb-3"><i class="bi bi-pen me-2"></i>Değerlendirmenizi Yazın</h5>
                                                <form id="reviewForm">
                                                    <input type="hidden" id="reviewProductId" value="@Model.Id" />
                                                    
                                                    <!-- Star Rating Selection -->
                                                    <div class="mb-3">
                                                        <label class="form-label">Puanınız <span class="text-danger">*</span></label>
                                                        <div class="pdp-star-rating" id="starRatingInput">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <button type="button" class="btn-star" data-rating="@i" onclick="setRating(@i)">
                                                                    <i class="bi bi-star fs-4"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                        <input type="hidden" id="reviewRating" value="0" />
                                                    </div>
                                                    
                                                    <!-- Title -->
                                                    <div class="mb-3">
                                                        <label for="reviewTitle" class="form-label">Başlık</label>
                                                        <input type="text" class="form-control" id="reviewTitle" placeholder="Değerlendirmenize bir başlık verin" maxlength="200" />
                                                    </div>
                                                    
                                                    <!-- Comment -->
                                                    <div class="mb-3">
                                                        <label for="reviewComment" class="form-label">Yorumunuz <span class="text-danger">*</span></label>
                                                        <textarea class="form-control" id="reviewComment" rows="4" placeholder="Ürün hakkındaki düşüncelerinizi paylaşın (en az 10 karakter)" minlength="10" maxlength="2000" required></textarea>
                                                        <div class="form-text"><span id="charCount">0</span>/2000 karakter</div>
                                                    </div>
                                                    
                                                    <button type="button" class="btn btn-primary" onclick="submitReview()">
                                                        <i class="bi bi-send me-2"></i>Gönder
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                    else if (isLoggedIn && hasUserReviewed)
                                    {
                                        <div class="alert alert-info mb-4">
                                            <i class="bi bi-check-circle me-2"></i>
                                            Bu ürün için zaten bir değerlendirme yapmışsınız.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mb-4">
                                            <i class="bi bi-person me-2"></i>
                                            Değerlendirme yapmak için <a href="/Account/Login" class="alert-link">giriş yapın</a>.
                                        </div>
                                    }
                                    
                                    <!-- Reviews List -->
                                    <div class="pdp-reviews-list">
                                        <h5 class="mb-3"><i class="bi bi-chat-left-text me-2"></i>Müşteri Değerlendirmeleri</h5>
                                        
                                        @if (reviews.Any())
                                        {
                                            @foreach (var review in reviews)
                                            {
                                                <div class="pdp-review-item card mb-3">
                                                    <div class="card-body">
                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                            <div>
                                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                                    <div class="d-flex gap-0">
                                                                        @for (int i = 1; i <= 5; i++)
                                                                        {
                                                                            if (i <= review.Rating)
                                                                            {
                                                                                <i class="bi bi-star-fill text-warning"></i>
                                                                            }
                                                                            else
                                                                            {
                                                                                <i class="bi bi-star text-muted"></i>
                                                                            }
                                                                        }
                                                                    </div>
                                                                    @if (!string.IsNullOrEmpty(review.Title))
                                                                    {
                                                                        <strong class="ms-2">@review.Title</strong>
                                                                    }
                                                                </div>
                                                                <small class="text-muted">
                                                                    <i class="bi bi-person me-1"></i>@review.User.FullName
                                                                    <span class="mx-2">•</span>
                                                                    <i class="bi bi-calendar me-1"></i>@review.CreatedAt.ToString("dd MMMM yyyy")
                                                                </small>
                                                            </div>
                                                        </div>
                                                        <p class="mb-0 mt-2">@review.Comment</p>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center py-4 text-muted">
                                                <i class="bi bi-chat-left-text fs-1 d-block mb-2"></i>
                                                <p>Henüz değerlendirme yapılmamış. İlk değerlendirmeyi siz yapın!</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products (Cross-sell) -->
    @if (relatedProducts.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <h3 class="product-section-title">İlgili Ürünler</h3>
                <div class="product-scroll-container">
                    <button class="product-scroll-btn prev" onclick="scrollRelatedProducts(-1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <div class="product-scroll-wrapper" id="relatedProductsWrapper">
                        @foreach (var related in relatedProducts)
                        {
                            var relatedPrice = isB2B ? related.PriceB2B : related.PriceB2C;
                            var relatedImageUrl = related.Image?.StartsWith("http") == true ? related.Image : Url.Content($"~/images/{related.Image}");
                            <div class="product-card">
                                <a href="/Catalog/Details/@related.Id" class="text-decoration-none">
                                    <div class="product-card-image">
                                        <img src="@relatedImageUrl" alt="@related.Name">
                                    </div>
                                    <div class="product-card-body p-3">
                                        <span class="product-card-brand">@related.Brand?.Name</span>
                                        <h5 class="product-card-title">@related.Name</h5>
                                        <div class="d-flex align-items-center gap-1 mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Floor(related.Rating))
                                                {
                                                    <i class="bi bi-star-fill text-warning small"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-muted small"></i>
                                                }
                                            }
                                            <span class="text-muted small">(@related.ReviewCount)</span>
                                        </div>
                                        @if (isLoggedIn)
                                        {
                                            <div class="product-card-price">@relatedPrice.ToString("N0") ₺</div>
                                        }
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                    <button class="product-scroll-btn next" onclick="scrollRelatedProducts(1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Back Button -->
    <div class="mt-4">
        <a href="/Catalog" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Katalog'a Dön
        </a>
    </div>
</div>

@section Scripts {
<script>
    const productId = @Model.Id;
    let maxStock = @Model.Stock;
    let currentVariationId = null;
    const isLoggedIn = @(isLoggedIn.ToString().ToLower());
    const isB2B = @(isB2B.ToString().ToLower());

    // Image Gallery - Zoom functionality (Enhanced)
    function initZoom() {
        const container = document.getElementById('mainImageContainer');
        const img = document.getElementById('mainImage');
        const lens = document.getElementById('zoomLens');
        const result = document.getElementById('zoomResult');

        if (!container || !img || !lens || !result) return;

        const zoomLevel = 3; // 3x magnification
        let isZoomActive = false;

        // Calculate zoom on image load
        function setupZoom() {
            const imgRect = img.getBoundingClientRect();
            result.style.backgroundImage = `url('${img.src}')`;
            result.style.backgroundSize = `${imgRect.width * zoomLevel}px ${imgRect.height * zoomLevel}px`;
        }

        // Re-setup on image change
        img.addEventListener('load', setupZoom);
        if (img.complete) setupZoom();

        container.addEventListener('mouseenter', function() {
            isZoomActive = true;
            lens.style.display = 'block';
            result.style.display = 'block';
            result.style.backgroundImage = `url('${img.src}')`;
            
            // Recalculate on hover start
            const imgRect = img.getBoundingClientRect();
            result.style.backgroundSize = `${imgRect.width * zoomLevel}px ${imgRect.height * zoomLevel}px`;
        });

        container.addEventListener('mouseleave', function() {
            isZoomActive = false;
            lens.style.display = 'none';
            result.style.display = 'none';
        });

        container.addEventListener('mousemove', function(e) {
            if (!isZoomActive) return;

            const containerRect = container.getBoundingClientRect();
            const imgRect = img.getBoundingClientRect();
            
            // Mouse position relative to image
            const mouseX = e.clientX - imgRect.left;
            const mouseY = e.clientY - imgRect.top;

            // Lens position (centered on cursor, relative to container)
            const lensSize = 100;
            let lensX = (e.clientX - containerRect.left) - lensSize / 2;
            let lensY = (e.clientY - containerRect.top) - lensSize / 2;

            // Boundary check for lens
            lensX = Math.max(0, Math.min(lensX, containerRect.width - lensSize));
            lensY = Math.max(0, Math.min(lensY, containerRect.height - lensSize));

            lens.style.left = lensX + 'px';
            lens.style.top = lensY + 'px';

            // Calculate percentage position within the image
            const percentX = (mouseX / imgRect.width) * 100;
            const percentY = (mouseY / imgRect.height) * 100;

            // Clamp percentages to valid range
            const clampedX = Math.max(0, Math.min(percentX, 100));
            const clampedY = Math.max(0, Math.min(percentY, 100));

            // Update zoom result background position
            result.style.backgroundPosition = `${clampedX}% ${clampedY}%`;
        });
    }

    function changeMainImage(url, thumb) {
        const mainImage = document.getElementById('mainImage');
        mainImage.src = url;
        
        document.querySelectorAll('.pdp-thumbnail').forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');
    }

    // Variation selection
    document.querySelectorAll('.pdp-color-swatch, .pdp-capacity-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
            const type = this.dataset.variationType;
            const value = this.dataset.variationValue;
            const stock = parseInt(this.dataset.stock);

            // Update selection UI
            if (type === 'Color') {
                document.querySelectorAll('.pdp-color-swatch').forEach(s => s.classList.remove('active'));
                document.getElementById('selectedColor').textContent = value;
            } else {
                document.querySelectorAll('.pdp-capacity-btn').forEach(s => s.classList.remove('active'));
            }
            this.classList.add('active');

            // Fetch variation details
            try {
                const response = await fetch(`/Catalog/GetVariationInfo?productId=${productId}&variationType=${type}&value=${encodeURIComponent(value)}`);
                const data = await response.json();

                if (data.success) {
                    // Update price
                    const priceEl = document.getElementById('currentPrice');
                    if (priceEl) priceEl.textContent = data.priceFormatted;

                    // Update stock
                    maxStock = data.stock;
                    updateStockUI(data.stock);

                    // Update SKU
                    const skuEl = document.getElementById('productSku');
                    if (skuEl && data.sku) skuEl.textContent = data.sku;

                    // Update image if variation has specific image
                    if (data.imageUrl) {
                        document.getElementById('mainImage').src = data.imageUrl;
                    }

                    // Store variation ID for notify request
                    currentVariationId = data.variationId;
                }
            } catch (error) {
                console.error('Varyasyon bilgisi alınamadı:', error);
            }
        });
    });

    function updateStockUI(stock) {
        const stockSection = document.getElementById('stockSection');
        const actionSection = document.getElementById('actionSection');

        if (stock > 10) {
            stockSection.innerHTML = '<span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Stokta Var</span>';
        } else if (stock > 0) {
            stockSection.innerHTML = `<span class="badge bg-warning text-dark fs-6"><i class="bi bi-exclamation-circle me-1"></i>Son ${stock} Adet!</span>`;
        } else {
            stockSection.innerHTML = '<span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Stokta Yok</span>';
        }

        // Update add to cart / notify me
        if (isLoggedIn) {
            if (stock > 0) {
                actionSection.innerHTML = `
                    <div class="d-flex align-items-center gap-3 mb-4" id="addToCartSection">
                        <div class="d-flex align-items-center border rounded">
                            <button class="btn btn-outline-secondary border-0 px-3" onclick="decreaseDetailQty()">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input type="number" id="detail-qty" class="form-control border-0 text-center" 
                                   value="1" min="1" max="${stock}" style="width: 60px;"
                                   onchange="validateDetailQty()">
                            <button class="btn btn-outline-secondary border-0 px-3" onclick="increaseDetailQty()">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                        <button class="btn btn-primary btn-lg flex-grow-1" id="addToCartBtn" onclick="addToCartDetail(${productId})">
                            <i class="bi bi-cart-plus me-2"></i>Sepete Ekle
                        </button>
                    </div>`;
            } else {
                actionSection.innerHTML = `
                    <div class="mb-4" id="notifyMeSection">
                        <div class="alert alert-info">
                            <i class="bi bi-bell me-2"></i>
                            <strong>Stokta yok!</strong> Ürün stoğa girdiğinde bildirim almak ister misiniz?
                        </div>
                        <div class="input-group">
                            <input type="email" class="form-control" id="notifyEmail" placeholder="E-posta adresiniz" value="${'@userEmail'}">
                            <button class="btn btn-warning" onclick="notifyWhenAvailable(${productId})">
                                <i class="bi bi-bell me-2"></i>Gelince Haber Ver
                            </button>
                        </div>
                    </div>`;
            }
        }
    }

    function decreaseDetailQty() {
        const input = document.getElementById('detail-qty');
        let value = parseInt(input.value) - 1;
        if (value < 1) value = 1;
        input.value = value;
    }

    function increaseDetailQty() {
        const input = document.getElementById('detail-qty');
        let value = parseInt(input.value) + 1;
        if (value > maxStock) {
            value = maxStock;
            showToast(`Maksimum ${maxStock} adet ekleyebilirsiniz.`, 'warning');
        }
        input.value = value;
    }

    function validateDetailQty() {
        const input = document.getElementById('detail-qty');
        let value = parseInt(input.value);
        if (isNaN(value) || value < 1) value = 1;
        if (value > maxStock) {
            value = maxStock;
            showToast(`Maksimum ${maxStock} adet ekleyebilirsiniz.`, 'warning');
        }
        input.value = value;
    }

    function addToCartDetail(productId) {
        const quantity = parseInt(document.getElementById('detail-qty').value) || 1;
        
        fetch('/Cart/Add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `productId=${productId}&quantity=${quantity}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const badge = document.querySelector('.cart-badge');
                if (badge) {
                    badge.textContent = data.cartCount;
                    badge.style.display = data.cartCount > 0 ? 'inline' : 'none';
                }
                showToast(`${quantity} adet ürün sepete eklendi!`);
            } else {
                showToast(data.message || 'Bir hata oluştu', 'error');
            }
        })
        .catch(error => {
            showToast('Bir hata oluştu', 'error');
        });
    }

    async function notifyWhenAvailable(productId) {
        const email = document.getElementById('notifyEmail')?.value;
        
        try {
            const response = await fetch('/Catalog/NotifyWhenAvailable', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId, variationId: currentVariationId, email })
            });
            const data = await response.json();
            
            if (data.success) {
                showToast(data.message, 'success');
            } else {
                showToast(data.message || 'Bir hata oluştu', 'error');
            }
        } catch (error) {
            showToast('Bir hata oluştu', 'error');
        }
    }

    function scrollRelatedProducts(direction) {
        const wrapper = document.getElementById('relatedProductsWrapper');
        const scrollAmount = 320 * direction;
        wrapper.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    }

    function showToast(message, type = 'success') {
        document.querySelectorAll('.custom-toast').forEach(t => t.remove());
        
        const toast = document.createElement('div');
        toast.className = `custom-toast alert alert-${type === 'error' ? 'danger' : type === 'warning' ? 'warning' : 'success'} position-fixed shadow`;
        toast.style.cssText = 'bottom: 20px; right: 20px; z-index: 9999; min-width: 250px;';
        
        const icon = type === 'error' ? 'x-circle' : type === 'warning' ? 'exclamation-circle' : 'check-circle';
        toast.innerHTML = `<i class="bi bi-${icon} me-2"></i>${message}`;
        document.body.appendChild(toast);
        
        setTimeout(() => toast.remove(), 3000);
    }

    // Initialize zoom on page load
    document.addEventListener('DOMContentLoaded', initZoom);

    // ===== REVIEW FUNCTIONS =====
    let selectedRating = 0;

    function setRating(rating) {
        selectedRating = rating;
        document.getElementById('reviewRating').value = rating;
        
        // Update star display
        const stars = document.querySelectorAll('#starRatingInput .btn-star');
        stars.forEach((star, index) => {
            const icon = star.querySelector('i');
            if (index < rating) {
                icon.classList.remove('bi-star');
                icon.classList.add('bi-star-fill', 'text-warning');
            } else {
                icon.classList.remove('bi-star-fill', 'text-warning');
                icon.classList.add('bi-star');
            }
        });
    }

    // Character counter for comment
    const reviewComment = document.getElementById('reviewComment');
    if (reviewComment) {
        reviewComment.addEventListener('input', function() {
            const charCount = document.getElementById('charCount');
            if (charCount) {
                charCount.textContent = this.value.length;
            }
        });
    }

    async function submitReview() {
        const rating = parseInt(document.getElementById('reviewRating').value);
        const title = document.getElementById('reviewTitle')?.value || '';
        const comment = document.getElementById('reviewComment')?.value || '';
        const productId = parseInt(document.getElementById('reviewProductId').value);

        // Validation
        if (rating < 1 || rating > 5) {
            showToast('Lütfen 1-5 arasında bir puan seçin', 'error');
            return;
        }

        if (comment.length < 10) {
            showToast('Yorum en az 10 karakter olmalıdır', 'error');
            return;
        }

        try {
            const response = await fetch('/Catalog/AddReview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId, rating, title, comment })
            });
            const data = await response.json();

            if (data.success) {
                showToast(data.message, 'success');
                // Reload after short delay to show updated reviews
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast(data.message || 'Bir hata oluştu', 'error');
            }
        } catch (error) {
            showToast('Bir hata oluştu', 'error');
        }
    }
</script>
}
