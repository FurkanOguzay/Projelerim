@model HomeViewModel
@using UpexTech.Entity
@{
    ViewData["Title"] = "Ana Sayfa";
    
    // Fiyat hesaplama fonksiyonu
    decimal CalculatePrice(Product product) {
        // Varsayılan fiyat (fallback için)
        decimal defaultPrice = Model.UserRole == UserRole.B2B ? product.PriceB2B : product.PriceB2C;
        
        if (Model.UserPriceList != null) {
            // PurchasePrice 0 veya null ise fallback fiyat kullan
            decimal basePrice = product.PurchasePrice > 0 ? product.PurchasePrice : defaultPrice;
            
            // PriceList Factor uygula
            decimal calculatedPrice = basePrice * Model.UserPriceList.Factor;
            
            // Yuvarlama uygula
            calculatedPrice = Model.UserPriceList.Rounding switch {
                RoundingMethod.Ending90 => Math.Floor(calculatedPrice) + 0.90m,
                RoundingMethod.Ending99 => Math.Floor(calculatedPrice) + 0.99m,
                RoundingMethod.NearestFive => Math.Round(calculatedPrice / 5) * 5,
                _ => Math.Round(calculatedPrice, 2)
            };
            
            // Hesaplanan fiyat 0 ise fallback kullan
            return calculatedPrice > 0 ? calculatedPrice : defaultPrice;
        }
        
        // PriceList yoksa varsayılan fiyat
        return defaultPrice;
    }
}

<!-- Banner Carousel -->
