            <div class="banner-overlay">
                <div class="banner-content">
                    <h2>Yeni iPhone 15 Serisi</h2>
                    <p>En yeni teknoloji artık burada!</p>
                    <a href="/Catalog" class="btn">Hemen İncele</a>
                </div>
            </div>
        </div>
        
        <!-- Slide 2 -->
        <div class="banner-slide">
            <img src="https://images.unsplash.com/photo-1610945415295-d9bbf067e59c?w=1200&h=400&fit=crop" alt="Samsung Galaxy">
            <div class="banner-overlay">
                <div class="banner-content">
                    <h2>Samsung Galaxy İndirimleri</h2>
                    <p>%30'a varan indirimler</p>
                    <a href="/Catalog" class="btn">Fırsatları Gör</a>
                </div>
            </div>
        </div>
        
        <!-- Slide 3 -->
        <div class="banner-slide">
            <img src="https://images.unsplash.com/photo-1598327105666-5b89351aff97?w=1200&h=400&fit=crop" alt="Aksesuarlar">
            <div class="banner-overlay">
                <div class="banner-content">
                    <h2>Aksesuarlarda Büyük İndirim</h2>
                    <p>Tüm aksesuar kategorilerinde</p>
                    <a href="/Catalog" class="btn">Keşfet</a>
                </div>
            </div>
        </div>
        
        <!-- Navigation Buttons -->
        <button class="banner-nav-btn prev" onclick="prevSlide()">
            <i data-lucide="chevron-left" style="width: 24px; height: 24px;"></i>
        </button>
        <button class="banner-nav-btn next" onclick="nextSlide()">
            <i data-lucide="chevron-right" style="width: 24px; height: 24px;"></i>
        </button>
        
        <!-- Dots -->
        <div class="banner-dots">
            <button class="banner-dot active" onclick="goToSlide(0)"></button>
            <button class="banner-dot" onclick="goToSlide(1)"></button>
            <button class="banner-dot" onclick="goToSlide(2)"></button>
        </div>
    </div>
</section>

<!-- En Çok Satanlar -->
<section class="container product-section">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="product-section-title mb-0">En Çok Satanlar</h2>
        <a href="/Catalog" class="btn btn-outline-primary btn-sm">
            Tümünü Gör <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </a>
    </div>
    <div class="product-scroll-container">
        <button class="product-scroll-btn prev" onclick="scrollProducts(this, 'left')">
            <i data-lucide="chevron-left" style="width: 24px; height: 24px;"></i>
        </button>
        <div class="product-scroll-wrapper">
            @foreach (var product in Model.PopularProducts)
            {
                var cardModel = new ProductCardViewModel
                {
                    Product = product,
                    ShowPrice = Model.IsLoggedIn,
                    IsB2B = Model.UserRole == UserRole.B2B,
                    IsFavorite = false,
                    IsLoggedIn = Model.IsLoggedIn,
                    CalculatedPrice = CalculatePrice(product)
                };
                <partial name="_ProductCard" model="cardModel" />
            }
        </div>
        <button class="product-scroll-btn next" onclick="scrollProducts(this, 'right')">
            <i data-lucide="chevron-right" style="width: 24px; height: 24px;"></i>
        </button>
    </div>
</section>

