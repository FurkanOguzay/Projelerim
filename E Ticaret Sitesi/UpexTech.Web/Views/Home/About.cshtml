@{
    ViewData["Title"] = "Hakkımızda";
}

<!-- Hero Section -->
<div class="bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold mb-3">Hakkımızda</h1>
                <p class="lead mb-0">Türkiye'nin en güvenilir teknoloji e-ticaret platformu</p>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Hikayemiz -->
    <div class="row mb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h2 class="fw-bold mb-4">Hikayemiz</h2>
            <p class="text-muted">
                UpexTech, 2024 yılında teknoloji tutkunları tarafından kurulmuş bir e-ticaret platformudur. 
                Amacımız, en son teknoloji ürünlerini hem bireysel tüketicilere hem de bayilere en uygun 
                fiyatlarla sunmaktır.
            </p>
            <p class="text-muted">
                B2B ve B2C iş modelimiz sayesinde, küçük işletmelerden büyük perakendecilere kadar 
                geniş bir müşteri kitlesine hizmet veriyoruz.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="bg-light rounded-4 p-5 text-center">
                <i class="bi bi-phone text-primary" style="font-size: 5rem;"></i>
            </div>
        </div>
    </div>

    <!-- Değerlerimiz -->
    <div class="row mb-5">
        <div class="col-12 text-center mb-4">
            <h2 class="fw-bold">Değerlerimiz</h2>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-shield-check text-primary fs-1"></i>
                </div>
                <h5 class="fw-bold">Güvenilirlik</h5>
                <p class="text-muted small">Tüm ürünlerimiz orijinal ve garantilidir. Müşteri memnuniyeti bizim için en önemli önceliktir.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-lightning-charge text-success fs-1"></i>
                </div>
                <h5 class="fw-bold">Hızlı Teslimat</h5>
                <p class="text-muted small">Siparişleriniz aynı gün kargoya verilir. Hemen teslim seçeneği ile anında sahip olun.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100 text-center p-4">
                <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-tag text-warning fs-1"></i>
                </div>
                <h5 class="fw-bold">En İyi Fiyat</h5>
                <p class="text-muted small">Rekabetçi fiyatlarımız ve bayi indirimleri ile bütçenize uygun seçenekler sunuyoruz.</p>
            </div>
        </div>
    </div>

    <!-- İstatistikler -->
    <div class="bg-primary text-white rounded-4 p-5 mb-5">
        <div class="row text-center">
            <div class="col-md-3 mb-4 mb-md-0">
                <h2 class="display-4 fw-bold">500+</h2>
                <p class="mb-0">Ürün Çeşidi</p>
            </div>
            <div class="col-md-3 mb-4 mb-md-0">
                <h2 class="display-4 fw-bold">10K+</h2>
                <p class="mb-0">Mutlu Müşteri</p>
            </div>
            <div class="col-md-3 mb-4 mb-md-0">
                <h2 class="display-4 fw-bold">50+</h2>
                <p class="mb-0">Bayi Ortağı</p>
            </div>
            <div class="col-md-3">
                <h2 class="display-4 fw-bold">81</h2>
                <p class="mb-0">İl'e Teslimat</p>
            </div>
        </div>
    </div>

    <!-- İletişim -->
    <div class="row">
        <div class="col-12 text-center mb-4">
            <h2 class="fw-bold">Bize Ulaşın</h2>
        </div>
        <div class="col-md-4 mb-4">
            <div class="text-center">
                <i class="bi bi-geo-alt text-primary fs-1 mb-3"></i>
                <h6 class="fw-bold">Adres</h6>
                <p class="text-muted small">Sakarya Üniversitesi Teknokent<br>Sakarya, Türkiye</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="text-center">
                <i class="bi bi-envelope text-primary fs-1 mb-3"></i>
                <h6 class="fw-bold">E-posta</h6>
                <p class="text-muted small">info@upextech.com<br>destek@upextech.com</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="text-center">
                <i class="bi bi-telephone text-primary fs-1 mb-3"></i>
                <h6 class="fw-bold">Telefon</h6>
                <p class="text-muted small">+90 264 123 45 67<br>Hafta içi 09:00 - 18:00</p>
            </div>
        </div>
    </div>
</div>
