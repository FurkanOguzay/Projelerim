@{
    ViewData["Title"] = "Müşteri Davranışı Raporu";
}

<div class="performance-page">
    <!-- Header -->
    <div class="performance-header simple">
        <div class="performance-header-left">
            <h1 class="performance-title">Müşteri Davranışı Analizi</h1>
            <p class="performance-subtitle">Müşteri sepet ve favori davranışları analizi</p>
        </div>
        
        <div class="performance-header-right">
            <button id="refreshBtn" class="btn-modern outline">
                <i class="fas fa-sync-alt"></i>
                <span>Yenile</span>
            </button>
            <button id="exportExcelBtn" class="btn-modern success">
                <i class="fas fa-file-excel"></i>
                <span>Excel İndir</span>
            </button>
        </div>
    </div>



    <!-- Report Table Card -->
    <div class="product-performance-card">
        <!-- Loading Spinner -->
        <div id="loadingSpinner" class="empty-state">
            <div class="spinner-border text-primary" role="status"></div>
            <p style="margin-top: 16px; color: var(--gray-500);">Rapor verileri yükleniyor...</p>
        </div>

        <!-- Error Message -->
        <div id="errorMessage" class="empty-state" style="display: none;">
            <div class="empty-icon" style="background: var(--danger-100);">
                <i class="fas fa-exclamation-circle" style="color: var(--danger-500);"></i>
            </div>
            <h3 style="color: var(--danger-700);">Hata</h3>
            <p id="errorText"></p>
        </div>

        <!-- Report Table -->
        <div id="reportTableContainer" style="display: none;">
            <div class="table-container">
                <table id="cartBehaviorTable" class="performance-table">
                    <thead>
                        <tr>
                            <th class="th-product">ÜRÜN BİLGİSİ</th>
                            <th>SKU</th>
                            <th>KATEGORİ</th>
                            <th class="th-cart">BRÜT SEPETE EKLENME</th>
                            <th class="th-cart">ŞU AN KAÇ SEPETTE</th>
                            <th class="th-cart">AKTİF FAVORİ</th>
                            <th class="th-count">NET SATIŞ ADEDİ</th>
                            <th class="th-revenue">NET CİRO</th>
                            <th class="th-stock">GÜNCEL STOK</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data will be populated via JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Table Footer -->
        <div class="table-footer" id="tableFooter" style="display: none;">
            <div class="footer-left">
                Toplam <span id="productCount">0</span> ürün listeleniyor
            </div>
            <div class="footer-right">
                <div class="stock-legend">
                    <span class="legend-dot red"></span>
                    <span>Stokta Yok</span>
                </div>
                <div class="stock-legend">
                    <span class="legend-dot green"></span>
                    <span>Normal Stok</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        let dataTable;

        $(document).ready(function() {
            loadReportData();

            // Yenile butonu
            $('#refreshBtn').click(function() {
                loadReportData();
            });

            // Excel indir butonu
            $('#exportExcelBtn').click(function() {
                window.location.href = '@Url.Action("ExportCartBehaviorToExcel", "Report")';
            });
        });

        function loadReportData() {
            // Loading göster
            $('#loadingSpinner').show();
            $('#reportTableContainer').hide();
            $('#errorMessage').hide();

            // Eğer tablo varsa destroy et
            if (dataTable) {
                dataTable.destroy();
            }

            // API'den veri çek
            $.ajax({
                url: '@Url.Action("GetCartBehaviorData", "Report")',
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        populateTable(response.data);
                        $('#loadingSpinner').hide();
                        $('#reportTableContainer').show();
                    } else {
                        showError(response.message || 'Veri yüklenirken hata oluştu.');
                    }
                },
                error: function(xhr, status, error) {
                    showError('Sunucu hatası: ' + error);
                }
            });
        }

        function populateTable(data) {
            const tbody = $('#cartBehaviorTable tbody');
            tbody.empty();

            if (data.length === 0) {
                tbody.append('<tr><td colspan="9" style="text-align: center; color: var(--gray-500); padding: 40px;">Henüz veri bulunmamaktadır.</td></tr>');
                $('#tableFooter').hide();
                return;
            }

            $('#tableFooter').show();
            $('#productCount').text(data.length);

            data.forEach(function(item) {
                const row = `
                    <tr>
                        <td class="td-product">
                            <span class="product-name">${item.productName}</span>
                        </td>
                        <td><span class="sku-badge">${item.sku}</span></td>
                        <td style="color: var(--gray-700);">${item.categoryName}</td>
                        <td class="td-cart">
                            <span class="metric-badge info">${item.grossCartAddCount}</span>
                        </td>
                        <td class="td-cart">
                            <span class="metric-badge primary">${item.currentCartUserCount}</span>
                        </td>
                        <td class="td-cart">
                            <span class="metric-badge warning">${item.currentFavoriteCount}</span>
                        </td>
                        <td class="td-count">
                            <strong style="color: var(--success-500);">${item.netSalesCount}</strong>
                        </td>
                        <td class="td-revenue">
                            <strong style="color: var(--success-500);">${formatCurrency(item.netRevenue)}</strong>
                        </td>
                        <td class="td-stock ${item.currentStock < 10 ? 'critical' : ''}">${formatStock(item.currentStock)}</td>
                    </tr>
                `;
                tbody.append(row);
            });

            // DataTable'ı başlat
            dataTable = $('#cartBehaviorTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json'
                },
                order: [[6, 'desc']], // Net Satış Adedi'ne göre azalan sırada
                pageLength: 25,
                responsive: true,
                dom: 'rtip',  // Remove length menu (l), keep processing (r), table (t), info (i), pagination (p)
                lengthChange: false  // Disable page length change dropdown
            });
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat('tr-TR', {
                style: 'currency',
                currency: 'TRY',
                minimumFractionDigits: 2
            }).format(value);
        }

        function formatStock(stock) {
            if (stock === 0) {
                return '<span class="stock-badge critical">Stokta Yok</span>';
            } else if (stock < 10) {
                return `<i class="fas fa-exclamation-triangle" style="color: var(--danger-500); margin-right: 4px;"></i><span>${stock} Adet</span>`;
            } else {
                return `<span>${stock} Adet</span>`;
            }
        }

        function showError(message) {
            $('#loadingSpinner').hide();
            $('#reportTableContainer').hide();
            $('#errorText').text(message);
            $('#errorMessage').show();
        }
    </script>

    <style>
        /* btn-modern styles */
        .btn-modern {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: var(--radius-lg);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--transition-fast);
            border: none;
        }
        
        .btn-modern.outline {
            background: var(--white);
            color: var(--primary-500);
            border: 1px solid var(--primary-500);
        }
        
        .btn-modern.outline:hover {
            background: var(--primary-50);
        }
        
        .btn-modern.success {
            background: linear-gradient(135deg, var(--success-500), #059669);
            color: var(--white);
        }
        
        .btn-modern.success:hover {
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }
        
        /* Performance header simple variant */
        .performance-header.simple {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            gap: 16px;
        }
        
        .performance-header-right {
            display: flex;
            gap: 12px;
        }
        
        /* Metric badges */
        .metric-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 40px;
            padding: 6px 12px;
            border-radius: 9999px;
            font-size: 13px;
            font-weight: 500;
        }
        
        .metric-badge.info {
            background: #dbeafe;
            color: #1d4ed8;
        }
        
        .metric-badge.primary {
            background: #4318FF;
            color: var(--white);
        }
        
        .metric-badge.warning {
            background: var(--warning-100);
            color: var(--warning-700);
        }
        
        /* SKU badge */
        .sku-badge {
            display: inline-flex;
            padding: 4px 10px;
            background: var(--gray-100);
            color: var(--gray-700);
            border-radius: var(--radius);
            font-size: 12px;
            font-family: 'SF Mono', 'Menlo', monospace;
        }
        
        /* Stock badge */
        .stock-badge.critical {
            padding: 4px 10px;
            background: var(--danger-100);
            color: var(--danger-700);
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 500;
        }
        
        /* Filters card adjustments */
        .filters-card .filters-row {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 16px;
        }
        
        /* Table adjustments */
        .performance-table .td-product {
            min-width: 300px;
        }
        
        .performance-table .th-cart,
        .performance-table .td-cart {
            text-align: center;
        }
        
        /* DataTables pagination fixes */
        .dataTables_wrapper .dataTables_paginate {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 4px;
            padding: 16px 24px;
        }
        
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 8px 14px !important;
            margin: 0 2px !important;
            border: 1px solid var(--gray-200) !important;
            border-radius: var(--radius) !important;
            background: var(--white) !important;
            color: var(--gray-700) !important;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: var(--gray-50) !important;
            border-color: var(--primary-500) !important;
            color: var(--primary-500) !important;
        }
        
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: #4318FF !important;
            border-color: #4318FF !important;
            color: var(--white) !important;
        }
        
        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .dataTables_wrapper .dataTables_info {
            padding: 16px 24px;
            font-size: 13px;
            color: var(--gray-600);
        }
        
        /* Hide info text if not needed */
        .dataTables_wrapper .dataTables_info {
            display: none;
        }
    </style>
}
