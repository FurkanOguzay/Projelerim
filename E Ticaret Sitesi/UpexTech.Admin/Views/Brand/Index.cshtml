@model IEnumerable<UpexTech.Entity.Brand>
@{
    ViewData["Title"] = "Markalar";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
        <h1>Markalar</h1>
        <p>Ürün markalarını görüntüleyin ve yönetin</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-new">
        <i class="fas fa-plus"></i>
        Yeni Marka
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="background: var(--success-50); border: 1px solid var(--success-200); color: var(--success-700); padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="data-table-container">
    <div style="overflow-x: auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Marka</th>
                    <th>Kategori</th>
                    <th>Açıklama</th>
                    <th>Durum</th>
                    <th>Oluşturulma</th>
                    <th style="width: 150px;">Aksiyonlar</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: var(--gray-500);">
                            <i class="fas fa-tags" style="font-size: 48px; margin-bottom: 16px; display: block;"></i>
                            Henüz marka bulunmuyor
                        </td>
                    </tr>
                }
                @foreach (var brand in Model)
                {
                    <tr>
                        <td>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                @if (!string.IsNullOrEmpty(brand.Logo))
                                {
                                    <img src="/images/@brand.Logo" alt="@brand.Name" style="width: 40px; height: 40px; object-fit: contain; border-radius: 8px; background: var(--gray-50);" onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <div style="width: 40px; height: 40px; background: var(--primary-100); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                        <span style="font-weight: 600; color: var(--primary-600);">@brand.Name.Substring(0, 1).ToUpper()</span>
                                    </div>
                                }
                                <span style="font-weight: 500; color: var(--gray-900);">@brand.Name</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge-category">@(brand.Category?.Name ?? "-")</span>
                        </td>
                        <td style="color: var(--gray-600); max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @(brand.Description ?? "-")
                        </td>
                        <td>
                            <button class="status-toggle @(brand.IsActive ? "active" : "")" 
                                    onclick="toggleStatus(@brand.Id, this)"
                                    title="@(brand.IsActive ? "Aktif" : "Pasif")">
                                <span class="status-dot"></span>
                                @(brand.IsActive ? "Aktif" : "Pasif")
                            </button>
                        </td>
                        <td style="color: var(--gray-500); font-size: 13px;">
                            @brand.CreatedAt.ToString("dd.MM.yyyy")
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a href="@Url.Action("Edit", new { id = brand.Id })" class="btn-icon" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@brand.Id" method="post" style="display: inline;" onsubmit="return confirm('Bu markayı silmek istediğinize emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-icon danger" title="Sil">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .btn-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: var(--primary-500);
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: background 0.2s;
    }
    .btn-new:hover {
        background: var(--primary-600);
        color: white;
    }
    .badge-category {
        display: inline-block;
        padding: 4px 12px;
        background: var(--primary-50);
        color: var(--primary-700);
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    .status-toggle {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 13px;
        border: none;
        cursor: pointer;
        background: var(--gray-100);
        color: var(--gray-600);
        transition: all 0.2s;
    }
    .status-toggle.active {
        background: var(--success-100);
        color: var(--success-700);
    }
    .status-toggle .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
    }
    .btn-icon.danger {
        color: var(--danger-500);
    }
    .btn-icon.danger:hover {
        background: var(--danger-50);
    }
</style>

@section Scripts {
    <script>
        function toggleStatus(id, btn) {
            fetch('/Brand/ToggleStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: `id=${id}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    btn.classList.toggle('active', data.isActive);
                    const textNode = Array.from(btn.childNodes).find(n => n.nodeType === 3);
                    if (textNode) textNode.textContent = data.isActive ? 'Aktif' : 'Pasif';
                }
            });
        }
    </script>
}
