        // Search and Sort Functions
        function filterTable(searchTerm) {
            const rows = document.querySelectorAll('.data-table tbody tr');
            const term = searchTerm.toLowerCase();
            
            rows.forEach(row => {
                const companyName = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
                const location = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
                
                if (companyName.includes(term) || location.includes(term)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
        
        function sortTable(sortBy) {
            if (!sortBy) return;
            
            const tbody = document.querySelector('.data-table tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));
            
            rows.sort((a, b) => {
                let aVal, bVal;
                
                switch(sortBy) {
                    case 'name-asc':
                    case 'name-desc':
                        aVal = a.querySelector('td:nth-child(2)')?.textContent.trim() || '';
                        bVal = b.querySelector('td:nth-child(2)')?.textContent.trim() || '';
                        return sortBy === 'name-asc' ? aVal.localeCompare(bVal, 'tr') : bVal.localeCompare(aVal, 'tr');
                    case 'revenue-asc':
                    case 'revenue-desc':
                        aVal = parseFloat(a.querySelector('td:nth-child(4)')?.textContent.replace(/[^\d]/g, '') || 0);
                        bVal = parseFloat(b.querySelector('td:nth-child(4)')?.textContent.replace(/[^\d]/g, '') || 0);
                        return sortBy === 'revenue-asc' ? aVal - bVal : bVal - aVal;
                    case 'balance-asc':
                    case 'balance-desc':
                        aVal = parseFloat(a.dataset.balance || 0);
                        bVal = parseFloat(b.dataset.balance || 0);
                        return sortBy === 'balance-asc' ? aVal - bVal : bVal - aVal;
                    default:
                        return 0;
                }
            });
            
            rows.forEach(row => tbody.appendChild(row));
            showAlert('Liste sıralandı.', 'success');
        }
        
        // exportToExcel function is defined earlier in the script section

        // Quick Order Panel Functions
        let quickOrderCart = [];
        let currentDealerId = null;
        
        // Sample products for demo
        const sampleProducts = [
            { id: 1, name: 'iPhone 15 Pro Max 256GB', sku: 'APL-IP15PM-256', barcode: '8901234567890', price: 78999 },
            { id: 2, name: 'Samsung Galaxy S24 Ultra', sku: 'SAM-S24U-256', barcode: '8901234567891', price: 72999 },
            { id: 3, name: 'MacBook Air M3 13"', sku: 'APL-MBA-M3-13', barcode: '8901234567892', price: 54999 },
            { id: 4, name: 'iPad Pro 12.9" M4', sku: 'APL-IPADP-M4', barcode: '8901234567893', price: 62999 },
            { id: 5, name: 'AirPods Pro 2nd Gen', sku: 'APL-APP2', barcode: '8901234567894', price: 8999 },
            { id: 6, name: 'Apple Watch Ultra 2', sku: 'APL-AWU2', barcode: '8901234567895', price: 29999 },
            { id: 7, name: 'Sony WH-1000XM5', sku: 'SNY-WH5', barcode: '8901234567896', price: 12999 },
            { id: 8, name: 'Samsung 65" OLED TV', sku: 'SAM-TV65-OLED', barcode: '8901234567897', price: 89999 }
        ];
        
        function openQuickOrderPanel(dealerId, companyName, balance) {
            currentDealerId = dealerId;
            quickOrderCart = [];
            
            document.getElementById('quickOrderCompany').textContent = companyName;
            document.getElementById('quickOrderCode').textContent = 'C-' + String(dealerId).padStart(5, '0');
            document.getElementById('quickOrderBalance').textContent = '₺' + Math.abs(balance).toLocaleString('tr-TR');
            document.getElementById('quickOrderBalance').style.color = balance > 0 ? 'var(--danger-500)' : 'var(--success-500)';
            document.getElementById('quickOrderSearch').value = '';
            document.getElementById('productResults').style.display = 'none';
            
            updateCart();
            
            document.getElementById('quickOrderPanel').style.display = 'block';
            document.body.style.overflow = 'hidden';
        }
        
        function closeQuickOrderPanel() {
            document.getElementById('quickOrderPanel').style.display = 'none';
            document.body.style.overflow = '';
        }
        
        function searchProducts(term) {
            const resultsDiv = document.getElementById('productResults');
            
            if (term.length < 2) {
                resultsDiv.style.display = 'none';
                return;
            }
            
            const filtered = sampleProducts.filter(p => 
                p.name.toLowerCase().includes(term.toLowerCase()) ||
                p.sku.toLowerCase().includes(term.toLowerCase()) ||
                p.barcode.includes(term)
            );
            
            if (filtered.length === 0) {
                resultsDiv.innerHTML = '<div style="padding: 16px; text-align: center; color: var(--gray-500);">Ürün bulunamadı</div>';
            } else {
                resultsDiv.innerHTML = filtered.map(p => `
                    <div class="product-result-item" onclick="addToCart(${p.id})" style="padding: 12px; border-bottom: 1px solid var(--gray-100); cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: background 0.2s;">
                        <div>
                            <p style="margin: 0; font-weight: 500; color: var(--gray-900);">${p.name}</p>
                            <p style="margin: 0; font-size: 12px; color: var(--gray-500);">${p.sku}</p>
                        </div>
                        <div style="text-align: right;">
                            <p style="margin: 0; font-weight: 600; color: var(--primary-500);">₺${p.price.toLocaleString('tr-TR')}</p>
                            <button class="btn btn-sm" style="padding: 4px 8px; font-size: 11px; background: var(--success-500); color: white; border: none; border-radius: 6px;">
                                <i class="fas fa-plus"></i> Ekle
                            </button>
                        </div>
                    </div>
                `).join('');
            }
            
            resultsDiv.style.display = 'block';
        }
        
        function addToCart(productId) {
            const product = sampleProducts.find(p => p.id === productId);
            if (!product) return;
            
            const existingItem = quickOrderCart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.quantity++;
            } else {
                quickOrderCart.push({ ...product, quantity: 1 });
            }
            
            updateCart();
            document.getElementById('quickOrderSearch').value = '';
            document.getElementById('productResults').style.display = 'none';
            showAlert(`${product.name} sepete eklendi.`, 'success');
        }
        
        function updateCartItemQuantity(productId, delta) {
            const item = quickOrderCart.find(i => i.id === productId);
            if (!item) return;
            
            item.quantity += delta;
            if (item.quantity <= 0) {
                quickOrderCart = quickOrderCart.filter(i => i.id !== productId);
            }
            
            updateCart();
        }
        
        function removeFromCart(productId) {
            quickOrderCart = quickOrderCart.filter(i => i.id !== productId);
            updateCart();
        }
        
        function updateCart() {
            const cartItemsDiv = document.getElementById('cartItems');
            const emptyMessage = document.getElementById('emptyCartMessage');
            const cartCount = document.getElementById('cartItemCount');
            const cartTotal = document.getElementById('cartTotal');
            
            if (quickOrderCart.length === 0) {
                emptyMessage.style.display = 'block';
                cartItemsDiv.innerHTML = '';
                cartItemsDiv.appendChild(emptyMessage);
                cartCount.textContent = '0 ürün';
                cartTotal.textContent = '₺0';
                return;
            }
            
            const totalItems = quickOrderCart.reduce((sum, item) => sum + item.quantity, 0);
            const totalPrice = quickOrderCart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            
            cartCount.textContent = totalItems + ' ürün';
            cartTotal.textContent = '₺' + totalPrice.toLocaleString('tr-TR');
            
            cartItemsDiv.innerHTML = quickOrderCart.map(item => `
                <div style="padding: 12px; border-bottom: 1px solid var(--gray-100); display: flex; justify-content: space-between; align-items: center;">
                    <div style="flex: 1;">
                        <p style="margin: 0; font-weight: 500; color: var(--gray-900); font-size: 13px;">${item.name}</p>
                        <p style="margin: 0; font-size: 12px; color: var(--gray-500);">₺${item.price.toLocaleString('tr-TR')} x ${item.quantity}</p>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="display: flex; align-items: center; gap: 4px; background: var(--gray-100); border-radius: 8px; padding: 4px;">
                            <button onclick="updateCartItemQuantity(${item.id}, -1)" style="width: 28px; height: 28px; border: none; background: white; border-radius: 6px; cursor: pointer; font-weight: bold;">-</button>
                            <span style="min-width: 24px; text-align: center; font-weight: 600;">${item.quantity}</span>
                            <button onclick="updateCartItemQuantity(${item.id}, 1)" style="width: 28px; height: 28px; border: none; background: white; border-radius: 6px; cursor: pointer; font-weight: bold;">+</button>
                        </div>
                        <button onclick="removeFromCart(${item.id})" style="width: 28px; height: 28px; border: none; background: var(--danger-100); color: var(--danger-500); border-radius: 6px; cursor: pointer;">
                            <i class="fas fa-trash" style="font-size: 12px;"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }
        
        function submitQuickOrder() {
            if (quickOrderCart.length === 0) {
                showAlert('Sepetiniz boş. Lütfen ürün ekleyin.', 'error');
                return;
            }
            
            const totalPrice = quickOrderCart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            
            closeQuickOrderPanel();
            showAlert(`₺${totalPrice.toLocaleString('tr-TR')} tutarında sipariş başarıyla oluşturuldu!`, 'success');
            
            // Reset cart
            quickOrderCart = [];
        }
        
        // Update openOrderModal to use Quick Order Panel
        function openOrderModal(dealerId, companyName) {
            // Get balance from row data
            const row = document.querySelector(`tr[data-dealer-id="${dealerId}"]`);
            const balance = row ? parseFloat(row.dataset.balance || 0) : 0;
            
            openQuickOrderPanel(dealerId, companyName, balance);
        }
    </script>
