@section Scripts {
    <script>
        // Toggle dropdown
        function toggleDropdown(btn) {
            const dropdown = btn.nextElementSibling;
            const allDropdowns = document.querySelectorAll('.dropdown-menu');
            
            allDropdowns.forEach(d => {
                if (d !== dropdown) d.classList.remove('show');
            });
            
            dropdown.classList.toggle('show');
        }
        
        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.dropdown')) {
                document.querySelectorAll('.dropdown-menu').forEach(d => d.classList.remove('show'));
            }
        });
        
        // Select all checkbox
        document.getElementById('selectAll')?.addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.dealer-checkbox');
            checkboxes.forEach(cb => cb.checked = this.checked);
        });
        
        // Modal functions
        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }
        
        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = '';
        }
        
        // Close modal on overlay click
        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.style.display = 'none';
                    document.body.style.overflow = '';
                }
            });
        });
        
        // Alert function
        function showAlert(message, type = 'success') {
            const alertHtml = `
                <div class="alert alert-${type}" style="background: var(--${type === 'success' ? 'success' : 'danger'}-100); color: var(--${type === 'success' ? 'success' : 'danger'}-700); padding: 16px 24px; border-radius: var(--radius-lg); margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
                    <i class="fas fa-${type === 'success' ? 'check' : 'times'}-circle"></i>
                    ${message}
                </div>
            `;
            document.getElementById('alertContainer').innerHTML = alertHtml;
            setTimeout(() => {
                document.getElementById('alertContainer').innerHTML = '';
            }, 5000);
        }
        
        // Excel Export
        function exportToExcel() {
            // Tablo verilerini al
            var table = document.querySelector('.data-table');
            if (!table) {
                showAlert('Dışa aktarılacak veri bulunamadı.', 'error');
                return;
            }
            
            // CSV formatında veri oluştur
            var csv = [];
            var rows = table.querySelectorAll('tr');
            
            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];
                var cols = row.querySelectorAll('td, th');
                var rowData = [];
                
                for (var j = 1; j < cols.length - 1; j++) {
                    var text = cols[j].innerText.replace(/[\n\r]+/g, ' ').trim();
                    // Virgül ve tırnak işaretlerini temizle
                    text = text.replace(/"/g, '""');
                    if (text.indexOf(',') > -1 || text.indexOf('"') > -1) {
                        text = '"' + text + '"';
                    }
                    rowData.push(text);
                }
                
                if (rowData.length > 0) {
                    csv.push(rowData.join(';'));
                }
            }
            
            // BOM ekle (Excel'de Türkçe karakterler için)
            var csvContent = '\uFEFF' + csv.join('\r\n');
            
            // Dosyayı indir
            var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement('a');
            
            if (navigator.msSaveBlob) {
                // IE için
                navigator.msSaveBlob(blob, 'cari_hesaplar.csv');
            } else {
                var url = URL.createObjectURL(blob);
                link.href = url;
                link.download = 'cari_hesaplar.csv';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
            }
            
            showAlert('Cari hesaplar Excel dosyası olarak indirildi!', 'success');
        }
        
        // New Dealer Modal
        function openNewDealerModal() {
            document.getElementById('newDealerForm').reset();
            openModal('newDealerModal');
        }
        
        function submitNewDealer(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            
            // Show loading state
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Kaydediliyor...';
            submitBtn.disabled = true;
            
            // Submit to server
            fetch('/CariHesap/CreateDealer', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                closeModal('newDealerModal');
                
                if (data.success) {
                    showAlert(data.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(data.message, 'error');
                }
            })
            .catch(error => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                showAlert('Bir hata oluştu. Lütfen tekrar deneyin.', 'error');
            });
        }
        
        // Contact Modal
        function openContactModal(dealerId) {
            const row = document.querySelector(`tr[data-dealer-id="${dealerId}"]`);
            if (row) {
                document.getElementById('contactCompany').textContent = row.dataset.company;
                document.getElementById('contactPerson').textContent = row.dataset.contact;
                document.getElementById('contactPhone').textContent = row.dataset.phone;
                document.getElementById('contactPhone').href = 'tel:' + row.dataset.phone;
                document.getElementById('contactEmail').textContent = row.dataset.email || '-';
                document.getElementById('contactEmail').href = 'mailto:' + row.dataset.email;
            }
            openModal('contactModal');
        }
        
        function copyContactInfo() {
            const company = document.getElementById('contactCompany').textContent;
            const person = document.getElementById('contactPerson').textContent;
            const phone = document.getElementById('contactPhone').textContent;
            const email = document.getElementById('contactEmail').textContent;
            
            const text = `${company}\n${person}\n${phone}\n${email}`;
            navigator.clipboard.writeText(text);
            showAlert('İletişim bilgileri panoya kopyalandı!', 'success');
        }
        
        // Risk Limit Modal
        function openRiskLimitModal(dealerId, companyName, currentLimit) {
            document.getElementById('riskLimitDealerId').value = dealerId;
            document.getElementById('riskLimitCompany').textContent = companyName;
            document.getElementById('riskLimitAmount').value = currentLimit;
            openModal('riskLimitModal');
        }
        
        function submitRiskLimit(e) {
            e.preventDefault();
            const form = document.getElementById('riskLimitForm');
            const formData = new FormData(form);
            
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Güncelleniyor...';
            submitBtn.disabled = true;
            
            fetch('/CariHesap/UpdateRiskLimit', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                closeModal('riskLimitModal');
                
                if (data.success) {
                    showAlert(data.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(data.message, 'error');
                }
            })
            .catch(error => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                showAlert('Bir hata oluştu. Lütfen tekrar deneyin.', 'error');
            });
        }
        
        // Payment Plan Modal
        function openPaymentPlanModal(dealerId, companyName, balance) {
            document.getElementById('paymentPlanCompany').textContent = companyName;
            document.getElementById('paymentPlanBalance').textContent = '₺' + Math.abs(balance).toLocaleString('tr-TR');
            
            // Generate mock payment plan
            const tbody = document.getElementById('paymentPlanBody');
            tbody.innerHTML = '';
            
            const installments = 3;
            const installmentAmount = Math.abs(balance) / installments;
            const today = new Date();
            
            for (let i = 1; i <= installments; i++) {
                const dueDate = new Date(today);
                dueDate.setDate(dueDate.getDate() + (i * 30));
                const isPaid = i === 1;
                
                tbody.innerHTML += `
                    <tr>
                        <td><strong>${i}. Taksit</strong></td>
                        <td>${dueDate.toLocaleDateString('tr-TR')}</td>
                        <td>₺${installmentAmount.toLocaleString('tr-TR', {maximumFractionDigits: 0})}</td>
                        <td>
                            <span style="padding: 4px 10px; border-radius: 9999px; font-size: 11px; font-weight: 500; ${isPaid ? 'background: var(--success-100); color: var(--success-700);' : 'background: var(--orange-100); color: var(--orange-700);'}">
                                ${isPaid ? 'Ödendi' : 'Bekliyor'}
                            </span>
                        </td>
                    </tr>
                `;
            }
            
            openModal('paymentPlanModal');
        }
        
        function printPaymentPlan() {
            window.print();
        }
        
        // Order Modal
        function openOrderModal(dealerId, companyName) {
            document.getElementById('orderDealerId').value = dealerId;
            document.getElementById('orderCompany').textContent = companyName;
            document.getElementById('orderAmount').value = '';
            openModal('orderModal');
        }
        
        function submitOrder(e) {
            e.preventDefault();
