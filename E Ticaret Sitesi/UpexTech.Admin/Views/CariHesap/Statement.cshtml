                        <td style="text-align: center;"><button class="btn btn-sm btn-outline">Detay</button></td>
                    </tr>
                    <tr>
                        <td><span style="font-family: monospace; background: var(--gray-100); padding: 4px 8px; border-radius: 6px;">#SP-2024-00128</span></td>
