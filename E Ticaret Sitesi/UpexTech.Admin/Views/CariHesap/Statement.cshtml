<!-- Payment Modal -->
<div id="paymentModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h2><i class="fas fa-credit-card" style="margin-right: 8px;"></i> Ödeme Ekle</h2>
            <button type="button" class="modal-close" onclick="closePaymentModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form asp-action="AddPayment" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" value="@Model.Dealer.Id" />
            <input type="hidden" name="DealerName" value="@Model.Dealer.CompanyName" />
            <input type="hidden" name="CurrentBalance" value="@Model.DealerSummary.Balance" />
            
            <div class="modal-body">
                <div class="form-info" style="background: var(--gray-50); padding: 16px; border-radius: var(--radius-lg); margin-bottom: 20px;">
                    <p style="color: var(--gray-600); margin-bottom: 4px;">Bayi: <strong style="color: var(--gray-900);">@Model.Dealer.CompanyName</strong></p>
                    <p style="color: var(--gray-600);">Mevcut Bakiye: 
                        <strong style="color: @balanceColor;">@Math.Abs(Model.DealerSummary.Balance).ToString("N2") ₺ (@balanceLabel)</strong>
                    </p>
                </div>
                
                <div class="form-group">
                    <label for="Amount">Ödeme Tutarı *</label>
                    <div style="position: relative;">
                        <input type="number" step="0.01" min="0.01" name="Amount" id="Amount" required 
                               style="width: 100%; padding: 12px; padding-right: 40px; border: 1px solid var(--gray-300); border-radius: var(--radius-lg); font-size: 16px;" 
                               placeholder="0.00" />
                        <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--gray-500);">₺</span>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="ReferenceNumber">Referans / Dekont No</label>
                    <input type="text" name="ReferenceNumber" id="ReferenceNumber" 
                           style="width: 100%; padding: 12px; border: 1px solid var(--gray-300); border-radius: var(--radius-lg);" 
                           placeholder="Havale/EFT referans numarası" />
                </div>
                
                <div class="form-group">
                    <label for="Description">Açıklama</label>
                    <textarea name="Description" id="Description" rows="3" 
                              style="width: 100%; padding: 12px; border: 1px solid var(--gray-300); border-radius: var(--radius-lg); resize: vertical;" 
                              placeholder="Ödeme ile ilgili notlar..."></textarea>
                </div>
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closePaymentModal()">İptal</button>
                <button type="submit" class="btn-primary">
                    <i class="fas fa-check" style="margin-right: 8px;"></i> Ödemeyi Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Debit Modal (Borçlandırma) -->
<div id="debitModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <div class="modal-header" style="border-bottom-color: var(--danger-200);">
            <h2 style="color: var(--danger-600);"><i class="fas fa-minus-circle" style="margin-right: 8px;"></i> Borçlandır</h2>
            <button type="button" class="modal-close" onclick="closeDebitModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form asp-action="AddDebit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" value="@Model.Dealer.Id" />
            <input type="hidden" name="DealerName" value="@Model.Dealer.CompanyName" />
            <input type="hidden" name="CurrentBalance" value="@Model.DealerSummary.Balance" />
            
            <div class="modal-body">
                <div class="form-info" style="background: var(--danger-50); padding: 16px; border-radius: var(--radius-lg); margin-bottom: 20px; border: 1px solid var(--danger-200);">
                    <p style="color: var(--gray-600); margin-bottom: 4px;">Bayi: <strong style="color: var(--gray-900);">@Model.Dealer.CompanyName</strong></p>
                    <p style="color: var(--gray-600);">Mevcut Bakiye: 
                        <strong style="color: @balanceColor;">@Math.Abs(Model.DealerSummary.Balance).ToString("N2") ₺ (@balanceLabel)</strong>
                    </p>
                </div>
                
                <div class="form-group">
                    <label for="DebitAmount">Borç Tutarı *</label>
                    <div style="position: relative;">
                        <input type="number" step="0.01" min="0.01" name="Amount" id="DebitAmount" required 
                               style="width: 100%; padding: 12px; padding-right: 40px; border: 1px solid var(--danger-300); border-radius: var(--radius-lg); font-size: 16px;" 
                               placeholder="0.00" />
                        <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--gray-500);">₺</span>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="DebitReferenceNumber">Fatura / Referans No</label>
                    <input type="text" name="ReferenceNumber" id="DebitReferenceNumber" 
                           style="width: 100%; padding: 12px; border: 1px solid var(--gray-300); border-radius: var(--radius-lg);" 
                           placeholder="Fatura numarası veya referans" />
                </div>
                
                <div class="form-group">
                    <label for="DebitDescription">Açıklama *</label>
                    <select name="Description" id="DebitDescription" required
                            style="width: 100%; padding: 12px; border: 1px solid var(--gray-300); border-radius: var(--radius-lg); background: white;">
                        <option value="">Borç türü seçin...</option>
                        <option value="Fatura Borcu">Fatura Borcu</option>
                        <option value="Sipariş Borcu">Sipariş Borcu</option>
                        <option value="Ek Masraf">Ek Masraf</option>
