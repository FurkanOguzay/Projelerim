@model IEnumerable<UpexTech.Entity.DeviceModel>
@{
    ViewData["Title"] = "Cihaz & Model Ağacı";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
        <h1>Cihaz & Model Ağacı</h1>
        <p>Marka, seri ve model hiyerarşisini yönetin</p>
    </div>
    <a href="@Url.Action("Create")" class="btn-new">
        <i class="fas fa-plus"></i>
        Yeni Marka Ekle
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="background: var(--success-100); color: var(--success-700); padding: 16px 24px; border-radius: var(--radius-lg); margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
        <i class="fas fa-check-circle"></i>
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="background: var(--danger-100); color: var(--danger-700); padding: 16px 24px; border-radius: var(--radius-lg); margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
        <i class="fas fa-exclamation-circle"></i>
        @TempData["ErrorMessage"]
    </div>
}

<div class="device-tree-container" style="background: var(--white); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm);">
    @foreach (var brand in Model)
    {
        <div class="tree-brand" style="margin-bottom: 16px;">
            <div class="tree-item level-0" style="display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; background: linear-gradient(135deg, var(--primary-50), var(--primary-100)); border-radius: var(--radius-lg); border-left: 4px solid var(--primary-500);">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <i class="fas fa-mobile-alt" style="font-size: 20px; color: var(--primary-500);"></i>
                    <span style="font-weight: 600; font-size: 16px; color: var(--gray-900);">@brand.Name</span>
                    <span style="background: var(--primary-500); color: white; padding: 2px 8px; border-radius: 12px; font-size: 12px;">@brand.Children.Count seri</span>
                </div>
                <div style="display: flex; gap: 8px;">
                    <a href="@Url.Action("Create", new { parentId = brand.Id })" class="btn-icon" title="Seri Ekle" style="background: var(--white);">
                        <i class="fas fa-plus"></i>
                    </a>
                    <a href="@Url.Action("Edit", new { id = brand.Id })" class="btn-icon" title="Düzenle" style="background: var(--white);">
                        <i class="fas fa-edit"></i>
                    </a>
                </div>
            </div>

            @if (brand.Children.Any())
            {
                <div class="tree-children" style="margin-left: 32px; margin-top: 8px;">
                    @foreach (var series in brand.Children.OrderBy(c => c.DisplayOrder))
                    {
                        <div class="tree-series" style="margin-bottom: 8px;">
                            <div class="tree-item level-1" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--gray-50); border-radius: var(--radius-md); border-left: 3px solid var(--gray-400);">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <i class="fas fa-layer-group" style="color: var(--gray-500);"></i>
                                    <span style="font-weight: 500; color: var(--gray-800);">@series.Name</span>
                                    <span style="background: var(--gray-200); color: var(--gray-600); padding: 2px 6px; border-radius: 10px; font-size: 11px;">@series.Children.Count model</span>
                                </div>
                                <div style="display: flex; gap: 6px;">
                                    <a href="@Url.Action("Create", new { parentId = series.Id })" class="btn-icon small" title="Model Ekle">
                                        <i class="fas fa-plus"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = series.Id })" class="btn-icon small" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@series.Id" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-icon small danger" title="Sil" onclick="return confirm('Bu seriyi silmek istediğinize emin misiniz?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            @if (series.Children.Any())
                            {
                                <div class="tree-models" style="margin-left: 24px; margin-top: 6px; display: flex; flex-wrap: wrap; gap: 8px;">
                                    @foreach (var deviceModel in series.Children.OrderBy(c => c.DisplayOrder))
                                    {
                                        <div class="tree-item level-2" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-sm);">
                                            <span style="font-size: 14px; color: var(--gray-700);">@deviceModel.Name</span>
                                            <a href="@Url.Action("Edit", new { id = deviceModel.Id })" style="color: var(--gray-400); font-size: 12px;" title="Düzenle">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@deviceModel.Id" method="post" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" style="background: none; border: none; color: var(--danger-400); font-size: 12px; cursor: pointer; padding: 0;" title="Sil" onclick="return confirm('Bu modeli silmek istediğinize emin misiniz?')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 60px 20px; color: var(--gray-500);">
            <i class="fas fa-mobile-alt" style="font-size: 48px; margin-bottom: 16px; opacity: 0.3;"></i>
            <p>Henüz cihaz modeli eklenmemiş.</p>
            <a href="@Url.Action("Create")" class="btn-new" style="margin-top: 16px;">
                <i class="fas fa-plus"></i> İlk Markayı Ekle
            </a>
        </div>
    }
</div>

<style>
    .btn-icon.small {
        width: 28px;
        height: 28px;
        font-size: 12px;
    }
</style>
