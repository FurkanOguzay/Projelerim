@section Scripts {
    <script>
        // City dropdown toggle
        document.getElementById('cityDropdownBtn')?.addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('cityDropdownContent').classList.toggle('show');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.filter-chip-dropdown')) {
                document.getElementById('cityDropdownContent')?.classList.remove('show');
            }
        });

        // Search on enter
        document.getElementById('customerSearchInput')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('customerFilterForm').submit();
            }
        });

        // Tier Modal functions
        function openTierModal(customerId, customerName, currentTier) {
            document.getElementById('tierCustomerId').value = customerId;
            document.getElementById('tierCustomerName').textContent = customerName + ' için seviye seçin:';
            document.getElementById('tierSelect').value = currentTier;
            document.getElementById('tierModal').style.display = 'flex';
        }

        function closeTierModal() {
            document.getElementById('tierModal').style.display = 'none';
        }

        document.getElementById('tierModal')?.addEventListener('click', function(e) {
            if (e.target === this) closeTierModal();
        });

        // Fiyat Listesi Modal functions
        function openPriceListModal(customerId, customerName, customerCode, customerRole) {
            document.getElementById('priceListCustomerId').value = customerId;
            document.getElementById('priceListCustomerName').textContent = customerName;
            document.getElementById('priceListCustomerCode').textContent = (customerRole === 'B2B' ? 'Cari Kodu: ' : 'Üye ID: ') + customerCode;
            document.getElementById('priceListSelect').value = '';
            document.getElementById('priceListModal').style.display = 'flex';
        }

        function closePriceListModal() {
            document.getElementById('priceListModal').style.display = 'none';
        }

        document.getElementById('priceListModal')?.addEventListener('click', function(e) {
            if (e.target === this) closePriceListModal();
        });

        // Form submit handler for price list - gerçek POST request
        document.getElementById('priceListForm')?.addEventListener('submit', function(e) {
            const priceListId = document.getElementById('priceListSelect').value;
            
            if (!priceListId) {
                e.preventDefault();
                alert('Lütfen bir fiyat listesi seçiniz.');
                return;
            }
            
            // Form normal şekilde submit olacak (POST request)
        });

        // SMS function placeholder
        function sendSMS(phone) {
            if (phone && phone !== '-') {
                alert('SMS g\u00f6nderilecek numara: ' + phone);
            } else {
                alert('Bu m\u00fc\u015fterinin telefon numaras\u0131 bulunmuyor.');
            }
        }
    </script>
}
