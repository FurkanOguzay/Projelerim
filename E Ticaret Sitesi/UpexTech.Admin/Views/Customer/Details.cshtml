@model UpexTech.Entity.User
@using UpexTech.Entity
@{
    ViewData["Title"] = "Müşteri Detayı";
}

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
        <h1>@Model.FullName</h1>
        <p>Müşteri detay bilgileri</p>
    </div>
    <a href="@Url.Action("Index")" class="btn-filter secondary">
        <i class="fas fa-arrow-left"></i>
        Geri
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="background: var(--success-100); color: var(--success-700); padding: 16px 24px; border-radius: var(--radius-lg); margin-bottom: 20px; display: flex; align-items: center; gap: 12px;">
        <i class="fas fa-check-circle"></i>
        @TempData["SuccessMessage"]
    </div>
}

<!-- Customer Header Card -->
<div class="card" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 24px;">
        <div style="display: flex; gap: 20px; align-items: center;">
            <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--primary-100); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-user" style="font-size: 32px; color: var(--primary-500);"></i>
            </div>
            <div>
                <h2 style="margin: 0 0 8px 0; color: var(--gray-900);">@Model.FullName</h2>
                <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                    @if (Model.Role == UserRole.B2B)
                    {
                        <span class="badge-type b2b"><i class="fas fa-building"></i> Kurumsal</span>
                    }
                    else
                    {
                        <span class="badge-type b2c"><i class="fas fa-user"></i> Bireysel</span>
                    }
                    @switch (Model.Tier)
                    {
                        case CustomerTier.Platinum:
                            <span class="dealer-tier platinum">Platinum</span>
                            break;
                        case CustomerTier.Gold:
                            <span class="dealer-tier gold">Gold</span>
                            break;
                        case CustomerTier.Silver:
                            <span class="dealer-tier silver">Silver</span>
                            break;
                        default:
                            <span class="dealer-tier standard">Standart</span>
                            break;
                    }
                    @if (Model.Status == UserStatus.Active)
                    {
                        <span class="badge-status delivered">Aktif</span>
                    }
                    else
                    {
                        <span class="badge-status pending">Beklemede</span>
                    }
                </div>
            </div>
        </div>
        @if (Model.Role == UserRole.B2B)
        {
            <div style="text-align: right;">
                <p style="color: var(--gray-500); margin: 0;">Kredi Limiti</p>
                <p style="font-size: 24px; font-weight: 600; color: var(--primary-500); margin: 4px 0;">
                    ₺@((Model.CreditLimit ?? 0).ToString("N0"))
                </p>
            </div>
        }
    </div>
</div>

<!-- Tabs -->
<div class="detail-tabs" style="margin-bottom: 24px;">
    <button class="detail-tab active" onclick="showTab('profile')">
        <i class="fas fa-user"></i> Profil Bilgileri
    </button>
    <button class="detail-tab" onclick="showTab('orders')">
        <i class="fas fa-shopping-bag"></i> Siparişler (@(Model.Orders?.Count ?? 0))
    </button>
    <button class="detail-tab" onclick="showTab('addresses')">
        <i class="fas fa-map-marker-alt"></i> Adresler
    </button>
</div>

<!-- Profile Tab -->
<div id="tab-profile" class="tab-content active">
    <div class="card">
        <h3 style="margin: 0 0 20px 0; color: var(--gray-900);">
            <i class="fas fa-user" style="color: var(--primary-500);"></i> İletişim Bilgileri
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
            <div class="info-item">
                <label>E-posta</label>
                <p>@Model.Email</p>
            </div>
            <div class="info-item">
                <label>Telefon</label>
                <p>@(Model.Phone ?? "-")</p>
            </div>
            <div class="info-item">
                <label>Kayıt Tarihi</label>
                <p>@Model.CreatedAt.ToString("dd MMMM yyyy")</p>
            </div>
        </div>
        
        @if (Model.Role == UserRole.B2B)
        {
            <hr style="margin: 24px 0; border: none; border-top: 1px solid var(--gray-100);" />
            <h3 style="margin: 0 0 20px 0; color: var(--gray-900);">
                <i class="fas fa-building" style="color: var(--primary-500);"></i> Firma Bilgileri
            </h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                <div class="info-item">
                    <label>Firma Adı</label>
                    <p>@(Model.CompanyName ?? "-")</p>
                </div>
                <div class="info-item">
                    <label>Vergi Numarası</label>
                    <p>@(Model.TaxNumber ?? "-")</p>
                </div>
                <div class="info-item">
                    <label>Adres</label>
                    <p>@(Model.Address ?? "-")</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Orders Tab -->
<div id="tab-orders" class="tab-content" style="display: none;">
    <div class="card">
        @if (Model.Orders != null && Model.Orders.Any())
        {
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Sipariş No</th>
                            <th>Tarih</th>
                            <th>Tutar</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt))
                        {
                            <tr>
                                <td><strong>@order.OrderNumber</strong></td>
                                <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>₺@order.TotalAmount.ToString("N0")</td>
                                <td>
                                    @switch (order.Status)
                                    {
                                        case OrderStatus.Pending:
                                            <span class="badge-status pending">Beklemede</span>
                                            break;
                                        case OrderStatus.Confirmed:
                                            <span class="badge-status preparing">Onaylandı</span>
                                            break;
                                        case OrderStatus.Shipped:
                                            <span class="badge-status shipped">Kargoda</span>
                                            break;
                                        case OrderStatus.Delivered:
                                            <span class="badge-status delivered">Teslim Edildi</span>
                                            break;
                                        case OrderStatus.Cancelled:
                                            <span class="badge-status cancelled">İptal</span>
                                            break;
                                        default:
                                            <span class="badge-status">@order.Status</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 40px; color: var(--gray-500);">
                <i class="fas fa-shopping-bag" style="font-size: 48px; opacity: 0.3; margin-bottom: 16px;"></i>
                <p>Henüz sipariş bulunmuyor.</p>
            </div>
        }
    </div>
</div>

<!-- Addresses Tab -->
<div id="tab-addresses" class="tab-content" style="display: none;">
    <div class="card">
        @if (!string.IsNullOrEmpty(Model.Address))
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                <div style="border: 1px solid var(--gray-200); border-radius: var(--radius-lg); padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <span style="background: var(--primary-100); color: var(--primary-600); padding: 4px 12px; border-radius: 20px; font-size: 12px;">Varsayılan</span>
                    </div>
                    <p style="color: var(--gray-900); margin: 0;">@Model.Address</p>
                </div>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 40px; color: var(--gray-500);">
                <i class="fas fa-map-marker-alt" style="font-size: 48px; opacity: 0.3; margin-bottom: 16px;"></i>
                <p>Kayıtlı adres bulunmuyor.</p>
            </div>
        }
    </div>
</div>

<style>
    .badge-type {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    .badge-type.b2b {
        background: linear-gradient(135deg, #e9d5ff 0%, #f3e8ff 100%);
        color: #7c3aed;
    }
    .badge-type.b2c {
        background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
        color: #2563eb;
    }
    .dealer-tier.standard {
        background: var(--gray-100);
        color: var(--gray-600);
    }
    .detail-tabs {
        display: flex;
        gap: 8px;
        border-bottom: 2px solid var(--gray-100);
        padding-bottom: 0;
    }
    .detail-tab {
        background: none;
        border: none;
        padding: 12px 20px;
        font-size: 14px;
        color: var(--gray-500);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .detail-tab:hover {
        color: var(--gray-700);
    }
    .detail-tab.active {
        color: var(--primary-500);
        border-bottom-color: var(--primary-500);
    }
    .info-item label {
        display: block;
        font-size: 13px;
        color: var(--gray-500);
        margin-bottom: 4px;
    }
    .info-item p {
        margin: 0;
        color: var(--gray-900);
        font-weight: 500;
    }
</style>

@section Scripts {
    <script>
        function showTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(function(tab) {
                tab.style.display = 'none';
            });
            // Remove active from all buttons
            document.querySelectorAll('.detail-tab').forEach(function(btn) {
                btn.classList.remove('active');
            });
            // Show selected tab
            document.getElementById('tab-' + tabName).style.display = 'block';
            // Add active to clicked button
            event.target.closest('.detail-tab').classList.add('active');
        }
    </script>
}
